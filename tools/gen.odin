// `./b3 gen`: the library's export layer and the Odin bindings, generated from the C headers and the port.
//
// Inputs: every `B3_API` prototype in include/box3d/*.h (upstream's headers, verbatim, plus unified.h: our
// additions), and the port (box3d/), parsed with core:odin/parser. Outputs, committed:
// - export/export.odin: one `@(export, link_name = "b3Name") Name :: proc "c"` per prototype, calling box3d.Name;
//   a port proc taking a slice where C takes (pointer, count) is adapted. B3_INLINE functions are not exported
//   (they are inline in C, and copied into the bindings).
// - bindings/: package box3d for Odin programs using the library. The types, constants and inline procs are
//   box3d/public_*.odin copied (minus what needs the port's internals), so they are identical by construction;
//   library.odin declares every exported function (`foreign import` of lib/<platform>/).
// - export/layout.odin and tests/bindings/layout.odin: `#assert`s that every public struct's size, alignment and
//   field offsets, and every enum's size and values, are C's (a probe compiled with clang prints them).
// It prints the API coverage: prototypes the port lacks, and port procs that look like API but aren't in the
// headers.
package tools

import "base:runtime"

import "core:fmt"
import "core:odin/ast"
import "core:odin/parser"
import "core:os"
import "core:slice"
import "core:strings"

@(init)
register_gen :: proc "contextless" () {
	context = runtime.default_context()
	register(
		Command {
			name = "gen",
			usage = "[--check]",
			summary = "generate export/, bindings/ and the layout asserts from include/box3d/*.h and box3d/ (--check: fail if out of date)",
			run = cmd_gen,
		},
	)
}

GEN_HEADERS := [?]string{"base", "math_functions", "id", "constants", "collision", "types", "box3d", "unified"}

// The public port files copied into bindings/, in order.
GEN_PUBLIC := [?]string{"base", "math_functions", "id", "constants", "collision", "types", "box3d"}

// Declarations of the public files the bindings leave out: internal helpers, and the length-scaled constants,
// which are package variables in the port and procs over the library's GetLengthUnitsPerMeter in the bindings
// (C's macros call b3GetLengthUnitsPerMeter() too).
GEN_DROP := [?]string {
	"InitLengthUnitConstants",
	"UpdateLengthUnitConstants",
	"HUGE",
	"LINEAR_SLOP",
	"MIN_CAPSULE_LENGTH",
	"OVERLAP_SLOP",
	"SPECULATIVE_DISTANCE",
	"MESH_REST_OFFSET",
	"CONTACT_RECYCLE_DISTANCE",
	"MAX_AABB_MARGIN",
}

GEN_LENGTH_CONSTANTS :: `
// The length-scaled constants: macros over b3GetLengthUnitsPerMeter() in C, procs here (the port keeps them in
// package variables that b3SetLengthUnitsPerMeter updates).
HUGE :: #force_inline proc "contextless" () -> f32 {return 1.0e5 * GetLengthUnitsPerMeter()}
LINEAR_SLOP :: #force_inline proc "contextless" () -> f32 {return 0.005 * GetLengthUnitsPerMeter()}
MIN_CAPSULE_LENGTH :: #force_inline proc "contextless" () -> f32 {return LINEAR_SLOP()}
OVERLAP_SLOP :: #force_inline proc "contextless" () -> f32 {return 0.1 * LINEAR_SLOP()}
SPECULATIVE_DISTANCE :: #force_inline proc "contextless" () -> f32 {return 4.0 * LINEAR_SLOP()}
MESH_REST_OFFSET :: #force_inline proc "contextless" () -> f32 {return 1.0 * LINEAR_SLOP()}
CONTACT_RECYCLE_DISTANCE :: #force_inline proc "contextless" () -> f32 {return 10.0 * LINEAR_SLOP()}
MAX_AABB_MARGIN :: #force_inline proc "contextless" () -> f32 {return 0.05 * GetLengthUnitsPerMeter()}
`

GEN_NOTE :: "Generated by `./b3 gen`; do not edit."

// A parameter of a C prototype.
C_Param :: struct {
	name:     string,
	base:     string, // the type without pointers, `const` and `struct`
	pointers: int,
}

C_Func :: struct {
	name:   string,
	header: string,
	ret:    C_Param, // name unused
	params: [dynamic]C_Param,
}

C_Api :: struct {
	funcs:   [dynamic]C_Func,
	structs: map[string]bool, // b3Name of every struct with a body
	opaque:  map[string]bool, // b3Name of every `typedef struct b3X b3X;` never defined
	enums:   map[string]bool,
	inline:  map[string]bool, // b3Name of every B3_INLINE function
}

// A top-level declaration of the port.
Port_Decl :: struct {
	name:  string,
	file:  ^ast.File,
	decl:  ^ast.Value_Decl,
	value: ^ast.Expr, // the proc literal or type expression
}

Port :: struct {
	pkg:   ^ast.Package,
	decls: map[string]Port_Decl,
}

cmd_gen :: proc(args: []string) -> bool {
	check := false
	for a in args {
		switch a {
		case "--check":
			check = true
		case:
			return fail("gen: unknown argument %q", a)
		}
	}

	api, aok := parse_headers()
	if !aok {
		return false
	}
	port, pok := parse_port()
	if !pok {
		return false
	}

	files := make(map[string]string, context.temp_allocator) // repo path -> content
	export_src, bindings_lib, ok := gen_functions(&api, &port)
	if !ok {
		return false
	}
	files["export/export.odin"] = export_src
	files["bindings/library.odin"] = bindings_lib

	structs := make([dynamic]^Port_Decl, context.temp_allocator)
	enums := make([dynamic]^Port_Decl, context.temp_allocator)
	gen_bindings_types(&api, &port, &files, &structs, &enums) or_return

	layout_ok := true
	if probe, pok2 := run_layout_probe(&api, &port, structs[:], enums[:]); pok2 {
		files["export/layout.odin"] = layout_file(probe, "box3d_export", `import box3d "../box3d"`, "box3d.")
		files["tests/bindings/layout.odin"] = layout_file(
			probe,
			"test_box3d_bindings",
			`import box3d "../../bindings"`,
			"box3d.",
		)
	} else {
		layout_ok = false
		log("gen: no layout probe (no C compiler: set CC, or install clang); the layout asserts are left as they are")
	}

	keys, _ := slice.map_keys(files, context.temp_allocator)
	slice.sort(keys)
	stale := 0
	for k in keys {
		p := path(k)
		old, _ := os.read_entire_file(p, context.temp_allocator)
		if string(old) == files[k] {
			continue
		}
		stale += 1
		if check {
			log("gen: %s is out of date", k)
			continue
		}
		dir := p[:strings.last_index_byte(p, '/')]
		os.make_directory_all(dir)
		if err := os.write_entire_file(p, transmute([]u8)files[k]); err != nil {
			return fail("gen: writing %s: %v", k, err)
		}
		log("gen: wrote %s (%d bytes)", k, len(files[k]))
	}
	if check && stale > 0 {
		return fail("gen: %d generated files are out of date (run ./b3 gen)", stale)
	}
	if stale == 0 {
		log("gen: everything up to date")
	}
	return layout_ok || !check
}

// ---- C headers ---------------------------------------------------------------------------------------------------

// The header text without comments and preprocessor lines.
c_strip :: proc(src: string) -> string {
	b := strings.builder_make(context.temp_allocator)
	i := 0
	line_start := true
	for i < len(src) {
		c := src[i]
		if line_start {
			j := i
			for j < len(src) && (src[j] == ' ' || src[j] == '\t') {
				j += 1
			}
			if j < len(src) && src[j] == '#' {
				// a preprocessor line, with its continuations
				for i < len(src) && src[i] != '\n' {
					if src[i] == '\\' && i + 1 < len(src) && (src[i + 1] == '\n' || src[i + 1] == '\r') {
						i += 1
					}
					i += 1
				}
				continue
			}
			line_start = false
		}
		if c == '/' && i + 1 < len(src) && src[i + 1] == '/' {
			for i < len(src) && src[i] != '\n' {
				i += 1
			}
			continue
		}
		if c == '/' && i + 1 < len(src) && src[i + 1] == '*' {
			end := strings.index(src[i + 2:], "*/")
			i = end < 0 ? len(src) : i + 2 + end + 2
			strings.write_byte(&b, ' ')
			continue
		}
		if c == '\n' {
			line_start = true
		}
		strings.write_byte(&b, c)
		i += 1
	}
	return strings.to_string(b)
}

is_ident_byte :: proc(c: u8) -> bool {
	return c == '_' || (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9')
}

// Whether `s` starts with the keyword `kw` (followed by a non-identifier byte).
c_keyword :: proc(s: string, kw: string) -> bool {
	return strings.has_prefix(s, kw) && len(s) > len(kw) && !is_ident_byte(s[len(kw)])
}

// "const b3Vec3* points" -> {points, b3Vec3, 1}; with `has_name` false the whole text is a type.
c_param :: proc(text: string, has_name: bool) -> (p: C_Param) {
	t := strings.trim_space(text)
	if has_name {
		// a trailing [N] makes it a pointer
		if strings.has_suffix(t, "]") {
			open := strings.last_index_byte(t, '[')
			t = strings.trim_space(t[:open])
			p.pointers += 1
		}
		k := len(t)
		for k > 0 && is_ident_byte(t[k - 1]) {
			k -= 1
		}
		p.name = t[k:]
		t = t[:k]
	}
	words := make([dynamic]string, context.temp_allocator)
	cur := strings.builder_make(context.temp_allocator)
	flush :: proc(words: ^[dynamic]string, cur: ^strings.Builder) {
		if strings.builder_len(cur^) > 0 {
			append(words, strings.clone(strings.to_string(cur^), context.temp_allocator))
			strings.builder_reset(cur)
		}
	}
	for i in 0 ..< len(t) {
		c := t[i]
		if c == '*' {
			flush(&words, &cur)
			p.pointers += 1
		} else if is_ident_byte(c) {
			strings.write_byte(&cur, c)
		} else {
			flush(&words, &cur)
		}
	}
	flush(&words, &cur)
	kept := make([dynamic]string, context.temp_allocator)
	for w in words {
		if w != "const" && w != "struct" && w != "B3_API" {
			append(&kept, w)
		}
	}
	p.base = strings.join(kept[:], " ", context.temp_allocator)
	return
}

parse_headers :: proc() -> (api: C_Api, ok: bool) {
	api.structs = make(map[string]bool, context.temp_allocator)
	api.opaque = make(map[string]bool, context.temp_allocator)
	api.enums = make(map[string]bool, context.temp_allocator)
	api.inline = make(map[string]bool, context.temp_allocator)
	declared := make(map[string]bool, context.temp_allocator)
	for h in GEN_HEADERS {
		raw, err := os.read_entire_file(path("include/box3d", fmt.tprintf("%s.h", h)), context.temp_allocator)
		if err != nil {
			return {}, fail("gen: reading include/box3d/%s.h: %v", h, err)
		}
		src := c_strip(string(raw))

		// struct, opaque and enum names
		rest := src
		for {
			k := strings.index(rest, "typedef ")
			if k < 0 {
				break
			}
			rest = rest[k + len("typedef "):]
			semi := strings.index_byte(rest, ';')
			brace := strings.index_byte(rest, '{')
			kind :=
				c_keyword(rest, "struct") ? "struct" : c_keyword(rest, "enum") ? "enum" : c_keyword(rest, "union") ? "union" : ""
			if kind == "" {
				continue
			}
			if brace >= 0 && (semi < 0 || brace < semi) {
				// a body: the name follows the matching close brace
				depth := 0
				j := brace
				for j < len(rest) {
					if rest[j] == '{' {
						depth += 1
					} else if rest[j] == '}' {
						depth -= 1
						if depth == 0 {
							break
						}
					}
					j += 1
				}
				end := strings.index_byte(rest[j:], ';')
				name := strings.trim_space(rest[j + 1:j + end])
				if kind == "enum" {
					api.enums[name] = true
				} else {
					api.structs[name] = true
				}
				declared[name] = true
				rest = rest[j + end:]
			} else if semi >= 0 && kind == "struct" {
				words := strings.fields(rest[:semi], context.temp_allocator)
				if len(words) == 3 {
					api.opaque[words[2]] = true
				}
			}
		}

		// B3_INLINE functions (copied into the bindings, not exported)
		rest = src
		for {
			k := strings.index(rest, "B3_INLINE")
			if k < 0 {
				break
			}
			rest = rest[k + len("B3_INLINE"):]
			open := strings.index_byte(rest, '(')
			if open > 0 {
				api.inline[c_param(rest[:open], true).name] = true
			}
		}

		// B3_API prototypes
		rest = src
		for {
			k := strings.index(rest, "B3_API")
			if k < 0 {
				break
			}
			rest = rest[k + len("B3_API"):]
			semi := strings.index_byte(rest, ';')
			decl := rest[:semi]
			rest = rest[semi:]
			open := strings.index_byte(decl, '(')
			close := strings.last_index_byte(decl, ')')
			if open < 0 || close < open {
				log("gen: skipping a B3_API declaration that is not a function: %s", strings.trim_space(decl))
				continue
			}
			f := C_Func {
				header = h,
				params = make([dynamic]C_Param, context.temp_allocator),
			}
			head := c_param(decl[:open], true)
			f.name = head.name
			f.ret = {
				base     = head.base,
				pointers = head.pointers,
			}
			inner := strings.trim_space(decl[open + 1:close])
			if inner != "void" && inner != "" {
				for part in strings.split(inner, ",", context.temp_allocator) {
					append(&f.params, c_param(part, true))
				}
			}
			append(&api.funcs, f)
		}
	}
	for name in api.opaque {
		if declared[name] {
			delete_key(&api.opaque, name)
		}
	}
	return api, true
}

// The Odin type C's type maps to, by the port's rules (PORTING.md "Types"); "" for void.
c_to_odin :: proc(p: C_Param, api: ^C_Api) -> string {
	base: string
	switch p.base {
	case "void":
		base = ""
	case "float":
		base = "f32"
	case "double":
		base = "f64"
	case "int", "int32_t":
		base = "i32"
	case "uint32_t", "unsigned", "unsigned int":
		base = "u32"
	case "int64_t":
		base = "i64"
	case "uint64_t":
		base = "u64"
	case "int16_t":
		base = "i16"
	case "uint16_t":
		base = "u16"
	case "int8_t":
		base = "i8"
	case "uint8_t":
		base = "u8"
	case "char":
		base = "u8"
	case "bool":
		base = "bool"
	case "size_t", "ptrdiff_t":
		base = "int"
	case:
		base = strings.trim_prefix(p.base, "b3")
	}
	if p.pointers == 0 {
		return base
	}
	if base == "" && p.pointers == 1 {
		return "rawptr"
	}
	if base == "u8" && p.base == "char" && p.pointers == 1 {
		return "cstring"
	}
	if p.pointers == 1 && (strings.has_suffix(p.base, "Fcn") || strings.has_suffix(p.base, "Callback")) {
		return base // a function typedef used through a pointer: a proc type in Odin
	}
	s := base
	for _ in 0 ..< p.pointers {
		s = fmt.tprintf("^%s", s)
	}
	return s
}

// Whether the port's parameter type (Odin source) passes the C type with the same ABI.
c_compatible :: proc(c: string, odin: string) -> bool {
	if c == odin {
		return true
	}
	if strings.has_prefix(c, "^") {
		elem := c[1:]
		if odin == fmt.tprintf("[^]%s", elem) {
			return true
		}
		if c == "^u8" && (odin == "cstring" || odin == "rawptr") {
			return true
		}
		if odin == "rawptr" {
			return true
		}
	}
	if c == "cstring" && odin == "[^]u8" {
		return true
	}
	return false
}

// ---- the port ----------------------------------------------------------------------------------------------------

parse_port :: proc() -> (port: Port, ok: bool) {
	pkg, cok := parser.collect_package(path("box3d"))
	if !cok {
		return {}, fail("gen: cannot read box3d/")
	}
	if !parser.parse_package(pkg) {
		return {}, fail("gen: box3d/ does not parse")
	}
	port.pkg = pkg
	port.decls = make(map[string]Port_Decl, context.temp_allocator)
	for _, file in pkg.files {
		for stmt in file.decls {
			vd, is_vd := stmt.derived.(^ast.Value_Decl)
			if !is_vd || len(vd.names) != 1 {
				continue
			}
			ident, is_ident := vd.names[0].derived.(^ast.Ident)
			if !is_ident {
				continue
			}
			d := Port_Decl {
				name = ident.name,
				file = file,
				decl = vd,
			}
			if len(vd.values) == 1 {
				d.value = vd.values[0]
			}
			port.decls[ident.name] = d
		}
	}
	return port, true
}

node_text :: proc(file: ^ast.File, n: ^ast.Node) -> string {
	return file.src[n.pos.offset:n.end.offset]
}

decl_is_private :: proc(d: ^Port_Decl) -> bool {
	for attr in d.decl.attributes {
		text := d.file.src[attr.pos.offset:attr.end.offset]
		if strings.contains(text, "private") {
			return true
		}
	}
	return false
}

// `text` with every identifier that names a port declaration prefixed (types in the export package).
qualify :: proc(text: string, port: ^Port, prefix: string) -> string {
	if prefix == "" {
		return text
	}
	b := strings.builder_make(context.temp_allocator)
	i := 0
	for i < len(text) {
		c := text[i]
		if is_ident_byte(c) && !(c >= '0' && c <= '9') && (i == 0 || text[i - 1] != '.') {
			j := i
			for j < len(text) && is_ident_byte(text[j]) {
				j += 1
			}
			word := text[i:j]
			if _, found := port.decls[word]; found {
				strings.write_string(&b, prefix)
			}
			strings.write_string(&b, word)
			i = j
			continue
		}
		strings.write_byte(&b, c)
		i += 1
	}
	return strings.to_string(b)
}

Port_Param :: struct {
	name:     string,
	type:     string,
	defaults: bool,
}

proc_params :: proc(d: ^Port_Decl) -> (params: [dynamic]Port_Param, results: string, contextless: bool, ok: bool) {
	lit, is_lit := d.value.derived.(^ast.Proc_Lit)
	if !is_lit {
		return
	}
	pt := lit.type
	if pt.generic {
		return
	}
	if cc, is_str := pt.calling_convention.(string); is_str {
		contextless = cc == `"contextless"` || cc == `"c"` || cc == "contextless" || cc == "c"
	}
	params = make([dynamic]Port_Param, context.temp_allocator)
	if pt.params != nil {
		for f in pt.params.list {
			if f.type == nil {
				return params, "", contextless, false // a parameter with only a default value
			}
			type := node_text(d.file, f.type)
			for n in f.names {
				append(
					&params,
					Port_Param{name = node_text(d.file, n), type = type, defaults = f.default_value != nil},
				)
			}
		}
	}
	if pt.results != nil && len(pt.results.list) > 0 {
		if len(pt.results.list) > 1 || len(pt.results.list[0].names) > 1 {
			return params, "", contextless, false
		}
		f := pt.results.list[0]
		if f.type == nil {
			return params, "", contextless, false
		}
		results = node_text(d.file, f.type) // a named result keeps only its type
	}
	return params, results, contextless, true
}

// ---- export/ and bindings/library.odin ---------------------------------------------------------------------------

gen_functions :: proc(api: ^C_Api, port: ^Port) -> (export_src, bindings_src: string, ok: bool) {
	ex := strings.builder_make(context.temp_allocator)
	bi := strings.builder_make(context.temp_allocator)
	fmt.sbprintfln(&ex, "// %s", GEN_NOTE)
	fmt.sbprintln(
		&ex,
		"// The library's exported API: upstream's C API (include/box3d/*.h) and our additions (unified.h), each a",
	)
	fmt.sbprintln(&ex, "// C-convention proc calling the port. Built by `./b3 build` into a shared library.")
	fmt.sbprintln(&ex, "package box3d_export\n\nimport \"base:runtime\"\n\nimport box3d \"../box3d\"\n")

	missing := make([dynamic]string, context.temp_allocator)
	mismatched := make([dynamic]string, context.temp_allocator)
	exported := make(map[string]bool, context.temp_allocator)
	headers_seen := ""
	count := 0

	for &f in api.funcs {
		oname := strings.trim_prefix(f.name, "b3")
		d, found := &port.decls[oname]
		if !found {
			d, found = &port.decls[fmt.tprintf("%s_", oname)]
		}
		if !found || decl_is_private(d) {
			append(&missing, f.name)
			continue
		}
		params, results, contextless, pok := proc_params(d)
		if !pok {
			append(&mismatched, fmt.tprintf("%s: the port's proc is generic or has unusual parameters", f.name))
			continue
		}

		// Match parameters: one to one, or a port slice for C's (pointer, count).
		ex_params := make([dynamic]string, context.temp_allocator) // export (qualified)
		bi_params := make([dynamic]string, context.temp_allocator) // bindings
		args := make([dynamic]string, context.temp_allocator)
		ci := 0
		bad := ""
		for p in params {
			if ci >= len(f.params) {
				if p.defaults {
					continue
				}
				bad = "more parameters than C"
				break
			}
			cp := f.params[ci]
			ctype := c_to_odin(cp, api)
			if strings.has_prefix(p.type, "[]") && ci + 1 < len(f.params) {
				elem := p.type[2:]
				count_p := f.params[ci + 1]
				if !c_compatible(ctype, fmt.tprintf("[^]%s", elem)) || c_to_odin(count_p, api) != "i32" {
					bad = fmt.tprintf(
						"slice parameter %s: C has %s %s, %s %s",
						p.name,
						cp.base,
						cp.name,
						count_p.base,
						count_p.name,
					)
					break
				}
				append(
					&ex_params,
					fmt.tprintf("%s: [^]%s, %s: i32", cp.name, qualify(elem, port, "box3d."), count_p.name),
				)
				append(&bi_params, fmt.tprintf("%s: [^]%s, %s: i32", cp.name, elem, count_p.name))
				append(&args, fmt.tprintf("%s[:%s]", cp.name, count_p.name))
				ci += 2
				continue
			}
			if !c_compatible(ctype, p.type) {
				bad = fmt.tprintf(
					"parameter %s: C %s%s (%s), port %s",
					p.name,
					cp.base,
					strings.repeat("*", cp.pointers, context.temp_allocator),
					ctype,
					p.type,
				)
				break
			}
			append(&ex_params, fmt.tprintf("%s: %s", p.name, qualify(p.type, port, "box3d.")))
			append(&bi_params, fmt.tprintf("%s: %s", p.name, p.type))
			append(&args, p.name)
			ci += 1
		}
		if bad == "" && ci != len(f.params) {
			bad = "fewer parameters than C"
		}
		cret := c_to_odin(f.ret, api)
		if bad == "" && !c_compatible(cret, results) {
			bad = fmt.tprintf("result: C %s, port %s", cret, results == "" ? "none" : results)
		}
		if bad != "" {
			append(&mismatched, fmt.tprintf("%s: %s", f.name, bad))
			continue
		}

		if f.header != headers_seen {
			headers_seen = f.header
			fmt.sbprintfln(&ex, "// ---- %s.h\n", f.header)
			fmt.sbprintfln(&bi, "\t// ---- %s.h\n", f.header)
		}
		ret_ex := results == "" ? "" : fmt.tprintf(" -> %s", qualify(results, port, "box3d."))
		ret_bi := results == "" ? "" : fmt.tprintf(" -> %s", results)
		fmt.sbprintfln(&ex, "@(export, link_name = %q)", f.name)
		fmt.sbprintfln(
			&ex,
			"%s :: proc \"c\" (%s)%s {{",
			oname,
			strings.join(ex_params[:], ", ", context.temp_allocator),
			ret_ex,
		)
		if !contextless {
			fmt.sbprintln(&ex, "\tcontext = runtime.default_context()")
		}
		call := fmt.tprintf("box3d.%s(%s)", d.name, strings.join(args[:], ", ", context.temp_allocator))
		if results == "" {
			fmt.sbprintfln(&ex, "\t%s", call)
		} else {
			fmt.sbprintfln(&ex, "\treturn %s", call)
		}
		fmt.sbprintln(&ex, "}\n")

		fmt.sbprintfln(&bi, "\t@(link_name = %q)", f.name)
		fmt.sbprintfln(
			&bi,
			"\t%s :: proc(%s)%s ---",
			oname,
			strings.join(bi_params[:], ", ", context.temp_allocator),
			ret_bi,
		)
		exported[d.name] = true
		count += 1
	}

	b := strings.builder_make(context.temp_allocator)
	fmt.sbprintfln(&b, "// %s", GEN_NOTE)
	fmt.sbprintln(
		&b,
		"// Every function the library exports (include/box3d/*.h), C convention. The library is built by",
	)
	fmt.sbprintln(&b, "// `./b3 build` into lib/<platform>/ (-define:BOX3D_LIB_DEBUG=true: the --debug build).")
	fmt.sbprintln(&b, "package box3d\n")
	fmt.sbprintln(&b, "BOX3D_LIB_DEBUG :: #config(BOX3D_LIB_DEBUG, false)")
	fmt.sbprintln(&b, "@(private)")
	fmt.sbprintln(&b, "LIB_SUFFIX :: \"-debug\" when BOX3D_LIB_DEBUG else \"\"\n")
	fmt.sbprintln(&b, "when ODIN_OS == .Windows && ODIN_ARCH == .amd64 {")
	fmt.sbprintln(&b, "\tforeign import lib {\"../lib/windows-x64\" + LIB_SUFFIX + \"/box3d.lib\"}")
	fmt.sbprintln(&b, "} else when ODIN_OS == .Linux && ODIN_ARCH == .amd64 {")
	fmt.sbprintln(&b, "\tforeign import lib {\"../lib/linux-x64\" + LIB_SUFFIX + \"/libbox3d.so\"}")
	fmt.sbprintln(&b, "} else when ODIN_OS == .Linux && ODIN_ARCH == .arm64 {")
	fmt.sbprintln(&b, "\tforeign import lib {\"../lib/linux-arm64\" + LIB_SUFFIX + \"/libbox3d.so\"}")
	fmt.sbprintln(&b, "} else when ODIN_OS == .Darwin && ODIN_ARCH == .arm64 {")
	fmt.sbprintln(&b, "\tforeign import lib {\"../lib/macos-arm64\" + LIB_SUFFIX + \"/libbox3d.dylib\"}")
	fmt.sbprintln(&b, "} else {")
	fmt.sbprintln(&b, "\t#panic(\"box3d bindings: unsupported platform\")")
	fmt.sbprintln(&b, "}\n")
	fmt.sbprintln(&b, "@(default_calling_convention = \"c\")")
	fmt.sbprintln(&b, "foreign lib {")
	strings.write_string(&b, strings.to_string(bi))
	fmt.sbprintln(&b, "}")

	// Coverage
	log("gen: %d functions in the headers, %d exported", len(api.funcs), count)
	for m in missing {
		log("gen: not in the port: %s", m)
	}
	for m in mismatched {
		log("gen: not exported (signature differs): %s", m)
	}
	prefixes := make(map[string]bool, context.temp_allocator)
	cnames := make(map[string]bool, context.temp_allocator)
	for f in api.funcs {
		name := strings.trim_prefix(f.name, "b3")
		cnames[name] = true
		if k := strings.index_byte(name, '_'); k > 0 {
			prefixes[name[:k + 1]] = true
		}
	}
	extra := make([dynamic]string, context.temp_allocator)
	for name, &d in port.decls {
		if d.value == nil {
			continue
		}
		if _, is_lit := d.value.derived.(^ast.Proc_Lit); !is_lit || decl_is_private(&d) {
			continue
		}
		if cnames[name] || cnames[strings.trim_suffix(name, "_")] || api.inline[fmt.tprintf("b3%s", name)] {
			continue
		}
		k := strings.index_byte(name, '_')
		if k > 0 && prefixes[name[:k + 1]] {
			append(&extra, name)
		}
	}
	slice.sort(extra[:])
	for e in extra {
		log("gen: port proc not in the headers (internal?): %s", e)
	}
	return strings.to_string(ex), strings.to_string(b), true
}

// ---- bindings types ----------------------------------------------------------------------------------------------

// The start of the line holding `offset`.
line_start :: proc(src: string, offset: int) -> int {
	i := offset
	for i > 0 && src[i - 1] != '\n' {
		i -= 1
	}
	return i
}

// The offset just past the end of the line holding `offset`.
line_end :: proc(src: string, offset: int) -> int {
	i := offset
	for i < len(src) && src[i] != '\n' {
		i += 1
	}
	return min(i + 1, len(src))
}

// `#config(NAME, value)` -> `value`: the bindings describe the library as built (default settings).
strip_config :: proc(src: string) -> string {
	b := strings.builder_make(context.temp_allocator)
	rest := src
	for {
		k := strings.index(rest, "#config(")
		if k < 0 {
			strings.write_string(&b, rest)
			break
		}
		strings.write_string(&b, rest[:k])
		inner := rest[k + len("#config("):]
		comma := strings.index_byte(inner, ',')
		close := strings.index_byte(inner, ')')
		strings.write_string(&b, strings.trim_space(inner[comma + 1:close]))
		rest = inner[close + 1:]
	}
	return strings.to_string(b)
}

// Whether `text` uses an identifier of the imported package `pkg` (`pkg.name`).
uses_package :: proc(text: string, pkg: string) -> bool {
	needle := fmt.tprintf("%s.", pkg)
	rest := text
	for {
		k := strings.index(rest, needle)
		if k < 0 {
			return false
		}
		after := k + len(needle)
		if (k == 0 || !is_ident_byte(rest[k - 1])) && after < len(rest) && is_ident_byte(rest[after]) {
			return true
		}
		rest = rest[after:]
	}
}

gen_bindings_types :: proc(
	api: ^C_Api,
	port: ^Port,
	files: ^map[string]string,
	structs, enums: ^[dynamic]^Port_Decl,
) -> bool {
	drop := make(map[string]bool, context.temp_allocator)
	for n in GEN_DROP {
		drop[n] = true
	}
	for f in api.funcs {
		drop[strings.trim_prefix(f.name, "b3")] = true // from the library
	}
	declared := make(map[string]bool, context.temp_allocator)

	collect :: proc(d: ^Port_Decl, structs, enums: ^[dynamic]^Port_Decl) {
		if d.value == nil {
			return
		}
		#partial switch _ in d.value.derived {
		case ^ast.Struct_Type:
			append(structs, d)
		case ^ast.Enum_Type:
			append(enums, d)
		}
	}

	for name in GEN_PUBLIC {
		file: ^ast.File
		for _, f in port.pkg.files {
			if strings.has_suffix(f.fullpath, fmt.tprintf("public_%s.odin", name)) {
				file = f
			}
		}
		if file == nil {
			return fail("gen: box3d/public_%s.odin not found", name)
		}
		src := file.src
		cuts := make([dynamic][2]int, context.temp_allocator)
		decls := make([dynamic]^Port_Decl, context.temp_allocator)
		for stmt in file.decls {
			#partial switch v in stmt.derived {
			case ^ast.Import_Decl:
				continue
			case ^ast.Value_Decl:
				if len(v.names) != 1 {
					continue
				}
				ident := v.names[0].derived.(^ast.Ident)
				if drop[ident.name] {
					start := v.pos.offset
					if v.docs != nil {
						start = min(start, v.docs.pos.offset)
					}
					for a in v.attributes {
						start = min(start, a.pos.offset)
					}
					append(&cuts, [2]int{line_start(src, start), line_end(src, v.end.offset)})
				} else {
					declared[ident.name] = true
					append(&decls, &port.decls[ident.name])
				}
			}
		}
		// drop the package clause and the header comment above it; keep what follows
		body_start := line_end(src, file.pkg_decl.end.offset)
		b := strings.builder_make(context.temp_allocator)
		fmt.sbprintfln(&b, "// %s From box3d/public_%s.odin.", GEN_NOTE, name)
		// keep the SPDX lines
		for line in strings.split_lines(src[:body_start], context.temp_allocator) {
			if strings.has_prefix(line, "// SPDX") {
				fmt.sbprintln(&b, line)
			}
		}
		fmt.sbprintln(&b, "package box3d")
		pos := body_start
		for c in cuts {
			if c[0] < pos {
				continue
			}
			strings.write_string(&b, src[pos:c[0]])
			pos = c[1]
		}
		strings.write_string(&b, src[pos:])
		// validation in the inline procs is the user's choice (-define:BOX3D_VALIDATE=true), not the port's debug build
		text, _ := strings.replace(
			strings.to_string(b),
			"#config(BOX3D_VALIDATE, B3_DEBUG)",
			"BOX3D_VALIDATE_CONFIG",
			1,
			context.temp_allocator,
		)
		text = strip_config(text)
		text, _ = strings.replace(
			text,
			"BOX3D_VALIDATE_CONFIG",
			"#config(BOX3D_VALIDATE, false)",
			1,
			context.temp_allocator,
		)
		if name == "constants" {
			text = strings.concatenate({text, GEN_LENGTH_CONSTANTS}, context.temp_allocator)
		}
		// unused imports go
		for line in strings.split_lines(text, context.temp_allocator) {
			if !strings.has_prefix(line, "import ") {
				continue
			}
			pkg := strings.trim_suffix(line[strings.last_index_byte(line, ':') + 1:], `"`)
			if !uses_package(text, pkg) {
				text, _ = strings.replace(text, fmt.tprintf("%s\n", line), "", 1, context.temp_allocator)
			}
		}
		files[fmt.tprintf("bindings/%s.odin", name)] = text
		for d in decls {
			collect(d, structs, enums)
		}
	}

	// Types the exported functions use that no public file declares: C's opaque handles, and our additions' structs
	// (copied from the port).
	lib := files["bindings/library.odin"]
	b := strings.builder_make(context.temp_allocator)
	fmt.sbprintfln(&b, "// %s", GEN_NOTE)
	fmt.sbprintln(
		&b,
		"// The types the exported functions use beyond the public files: C's opaque handles (only used through",
	)
	fmt.sbprintln(&b, "// pointers) and the structs of our additions (include/box3d/unified.h), copied from the port.")
	fmt.sbprintln(&b, "package box3d\n")
	opaque, _ := slice.map_keys(api.opaque, context.temp_allocator)
	slice.sort(opaque)
	for c in opaque {
		name := c[2:]
		if !declared[name] {
			fmt.sbprintfln(&b, "%s :: struct {{}}\n", name)
			declared[name] = true
		}
	}
	cstructs, _ := slice.map_keys(api.structs, context.temp_allocator)
	slice.sort(cstructs)
	for c in cstructs {
		name := c[2:]
		if declared[name] {
			continue
		}
		d, found := &port.decls[name]
		if !found {
			log("gen: C struct %s is not in the port", c)
			continue
		}
		if !strings.contains(lib, name) {
			continue
		}
		start := d.decl.pos.offset
		if d.decl.docs != nil {
			start = d.decl.docs.pos.offset
		}
		strings.write_string(&b, d.file.src[line_start(d.file.src, start):line_end(d.file.src, d.decl.end.offset)])
		strings.write_string(&b, "\n")
		declared[name] = true
		append(structs, d)
	}
	files["bindings/handles.odin"] = strings.to_string(b)
	return true
}

// ---- layout probe ------------------------------------------------------------------------------------------------

Probe :: struct {
	lines: [dynamic]string, // `#assert(...)` bodies, with `T.` standing for the package prefix
}

// The C member name of an Odin field (the port appends `_` to names that collide).
c_member :: proc(name: string) -> string {
	return strings.trim_suffix(name, "_")
}

run_layout_probe :: proc(api: ^C_Api, port: ^Port, structs, enums: []^Port_Decl) -> (probe: Probe, ok: bool) {
	cc := os.get_env("CC", context.temp_allocator)
	if cc == "" {
		cc = "clang"
	}
	c := strings.builder_make(context.temp_allocator)
	fmt.sbprintfln(&c, "// %s The layout probe: prints C's sizes, alignments, offsets and enum values.", GEN_NOTE)
	fmt.sbprintln(
		&c,
		"#include <stdio.h>\n#include <stddef.h>\n#include \"box3d/box3d.h\"\n#include \"box3d/unified.h\"\n",
	)
	fmt.sbprintln(
		&c,
		"#define S(T) printf(\"size_of(%s) == %zu\\nalign_of(%s) == %zu\\n\", #T, sizeof(b3##T), #T, _Alignof(b3##T))",
	)
	fmt.sbprintln(&c, "#define F(T, f, o) printf(\"offset_of(%s, %s) == %zu\\n\", #T, #o, offsetof(b3##T, f))")
	fmt.sbprintln(&c, "#define E(T, m) printf(\"i64(%s.%s) == %lld\\n\", #T, #m, (long long)b3_##m)\n")
	fmt.sbprintln(&c, "int main(void)\n{")
	skipped := make([dynamic]string, context.temp_allocator)
	for d in structs {
		if !api.structs[fmt.tprintf("b3%s", d.name)] {
			append(&skipped, d.name)
			continue
		}
		st := d.value.derived.(^ast.Struct_Type)
		fmt.sbprintfln(&c, "\tS(%s);", d.name)
		for f in st.fields.list {
			if _, is_bits := f.type.derived.(^ast.Bit_Field_Type); is_bits {
				continue // C bit-fields have no offset
			}
			for n in f.names {
				name := node_text(d.file, n)
				if name == "_" {
					// an anonymous union or struct: C reaches its members directly
					if inner, is_struct := f.type.derived.(^ast.Struct_Type); is_struct {
						for g in inner.fields.list {
							for m in g.names {
								mn := node_text(d.file, m)
								fmt.sbprintfln(&c, "\tF(%s, %s, %s);", d.name, c_member(mn), mn)
							}
						}
					}
					continue
				}
				fmt.sbprintfln(&c, "\tF(%s, %s, %s);", d.name, c_member(name), name)
			}
		}
	}
	for d in enums {
		if !api.enums[fmt.tprintf("b3%s", d.name)] {
			append(&skipped, d.name)
			continue
		}
		fmt.sbprintfln(&c, "\tS(%s);", d.name)
		et := d.value.derived.(^ast.Enum_Type)
		for f in et.fields {
			name: string
			#partial switch v in f.derived {
			case ^ast.Ident:
				name = v.name
			case ^ast.Field_Value:
				name = v.field.derived.(^ast.Ident).name
			}
			fmt.sbprintfln(&c, "\tE(%s, %s);", d.name, name)
		}
	}
	fmt.sbprintln(&c, "\treturn 0;\n}")
	for s in skipped {
		log("gen: no C counterpart for %s (layout not checked)", s)
	}

	dir := out("gen")
	os.make_directory_all(dir)
	src := fmt.tprintf("%s/layout_probe.c", dir)
	exe := fmt.tprintf("%s/layout_probe%s", dir, ODIN_OS == .Windows ? ".exe" : "")
	if err := os.write_entire_file(src, transmute([]u8)strings.to_string(c)); err != nil {
		return {}, fail("gen: writing %s: %v", src, err)
	}
	if !run({cc, "-std=c11", "-O0", "-w", fmt.tprintf("-I%s", path("include")), src, "-o", exe}) {
		return {}, false
	}
	output, rok := run_capture({exe})
	if !rok {
		return {}, fail("gen: the layout probe failed")
	}
	probe.lines = make([dynamic]string, context.temp_allocator)
	for line in strings.split_lines(output, context.temp_allocator) {
		l := strings.trim_space(line)
		if l != "" {
			append(&probe.lines, l)
		}
	}
	return probe, true
}

layout_file :: proc(probe: Probe, package_name: string, import_line: string, prefix: string) -> string {
	b := strings.builder_make(context.temp_allocator)
	fmt.sbprintfln(&b, "// %s", GEN_NOTE)
	fmt.sbprintfln(
		&b,
		"// The public structs and enums against C's layout (include/box3d/*.h, measured by `./b3 gen`'s probe on %s;",
		platform(),
	)
	fmt.sbprintln(&b, "// the layouts are the same on every 64-bit target we build).")
	fmt.sbprintfln(&b, "package %s\n\n%s\n", package_name, import_line)
	for l in probe.lines {
		// `size_of(Vec3) == 12` -> `#assert(size_of(box3d.Vec3) == 12)`
		open := strings.index_byte(l, '(')
		fmt.sbprintfln(&b, "#assert(%s(%s%s)", l[:open], prefix, l[open + 1:])
	}
	return strings.to_string(b)
}
