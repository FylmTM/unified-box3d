#+build amd64
// Ported from box3d src/contact_solver_wide.inl at 3362633 (PORTING.md).
// Generated by `./b3 gen`; do not edit. From box3d/contact_solver_wide.odin, at width 8 (tools/gen_wide.odin).
// SPDX-FileCopyrightText: 2026 Erin Catto
// SPDX-License-Identifier: MIT
package box3d

// This is the wide8.c instantiation (B3_SIMD_WIDTH 8): B3_WIDE(name) is name##W8, and every proc enables
// AVX2 (B3_AVX2_BEGIN). It is called only on a CPU that has AVX2 (simd.odin, DetectSIMDWidth).

// unified: B3_SIMD_WIDTH and B3_WIDE_ALIGNMENT, file-private (simd_wide.odin)
@(private = "file")
SIMD_WIDTH :: 8
@(private = "file")
WIDE_ALIGNMENT :: (4 * SIMD_WIDTH)
// unified end

// Wide vec2
Vec2W8 :: struct {
	x, y: FloatW8,
}

// Wide quaternion
QuatW8 :: struct {
	V: Vec3W8,
	S: FloatW8,
}

// Wide symmetric matrix2
SymMatrix2W8 :: struct {
	cxx, cxy, cyy: FloatW8,
}

// Wide symmetric matrix3
SymMatrix3W8 :: struct {
	cxx, cxy, cxz, cyy, cyz, czz: FloatW8,
}

Matrix3W8 :: struct {
	cx, cy, cz: Vec3W8,
}

// a + b
@(private = "file", enable_target_feature = "avx2")
AddV2W :: proc(a: Vec2W8, b: Vec2W8) -> Vec2W8 {
	return Vec2W8{AddW8(a.x, b.x), AddW8(a.y, b.y)}
}

// m * a
@(private = "file", enable_target_feature = "avx2")
MulMV2W :: proc(m: SymMatrix2W8, a: Vec2W8) -> Vec2W8 {
	b := Vec2W8{AddW8(MulW8(m.cxx, a.x), MulW8(m.cxy, a.y)), AddW8(MulW8(m.cxy, a.x), MulW8(m.cyy, a.y))}

	return b
}

// m * a
@(private = "file", enable_target_feature = "avx2")
MulMVW :: proc(m: SymMatrix3W8, a: Vec3W8) -> Vec3W8 {
	b := Vec3W8 {
		AddW8(MulW8(m.cxx, a.X), AddW8(MulW8(m.cxy, a.Y), MulW8(m.cxz, a.Z))),
		AddW8(MulW8(m.cxy, a.X), AddW8(MulW8(m.cyy, a.Y), MulW8(m.cyz, a.Z))),
		AddW8(MulW8(m.cxz, a.X), AddW8(MulW8(m.cyz, a.Y), MulW8(m.czz, a.Z))),
	}

	return b
}

// a - m * b
@(private = "file", enable_target_feature = "avx2")
MulSubMVW :: proc(a: Vec3W8, m: SymMatrix3W8, b: Vec3W8) -> Vec3W8 {
	c := Vec3W8 {
		AddW8(MulW8(m.cxx, b.X), AddW8(MulW8(m.cxy, b.Y), MulW8(m.cxz, b.Z))),
		AddW8(MulW8(m.cxy, b.X), AddW8(MulW8(m.cyy, b.Y), MulW8(m.cyz, b.Z))),
		AddW8(MulW8(m.cxz, b.X), AddW8(MulW8(m.cyz, b.Y), MulW8(m.czz, b.Z))),
	}

	return Vec3W8{SubW8(a.X, c.X), SubW8(a.Y, c.Y), SubW8(a.Z, c.Z)}
}

// a + m * b
@(private = "file", enable_target_feature = "avx2")
MulAddMVW :: proc(a: Vec3W8, m: SymMatrix3W8, b: Vec3W8) -> Vec3W8 {
	c := Vec3W8 {
		AddW8(MulW8(m.cxx, b.X), AddW8(MulW8(m.cxy, b.Y), MulW8(m.cxz, b.Z))),
		AddW8(MulW8(m.cxy, b.X), AddW8(MulW8(m.cyy, b.Y), MulW8(m.cyz, b.Z))),
		AddW8(MulW8(m.cxz, b.X), AddW8(MulW8(m.cyz, b.Y), MulW8(m.czz, b.Z))),
	}

	return Vec3W8{AddW8(a.X, c.X), AddW8(a.Y, c.Y), AddW8(a.Z, c.Z)}
}

@(private = "file", enable_target_feature = "avx2")
MulM3VW :: proc(m: Matrix3W8, a: Vec3W8) -> Vec3W8 {
	b := Vec3W8 {
		AddW8(MulW8(m.cx.X, a.X), AddW8(MulW8(m.cy.X, a.Y), MulW8(m.cz.X, a.Z))),
		AddW8(MulW8(m.cx.Y, a.X), AddW8(MulW8(m.cy.Y, a.Y), MulW8(m.cz.Y, a.Z))),
		AddW8(MulW8(m.cx.Z, a.X), AddW8(MulW8(m.cy.Z, a.Y), MulW8(m.cz.Z, a.Z))),
	}

	return b
}

@(private = "file", enable_target_feature = "avx2")
InvRotateVectorW :: proc(q: QuatW8, a: Vec3W8) -> Vec3W8 {
	t := CrossW8(q.V, a)
	t = Vec3W8{AddW8(t.X, t.X), AddW8(t.Y, t.Y), AddW8(t.Z, t.Z)}
	u := CrossW8(q.V, t)
	return Vec3W8 {
		AddW8(SubW8(a.X, MulW8(q.S, t.X)), u.X),
		AddW8(SubW8(a.Y, MulW8(q.S, t.Y)), u.Y),
		AddW8(SubW8(a.Z, MulW8(q.S, t.Z)), u.Z),
	}
}

// Soft contact constraints with sub-stepping support
// Uses fixed anchors for Jacobians for better behavior on rolling shapes (circles & capsules)
// http://mmacklin.com/smallsteps.pdf
// https://box2d.org/files/ErinCatto_SoftConstraints_GDC2011.pdf

ContactConstraintPointW8 :: struct {
	anchorAs, anchorBs:  Vec3W8,
	baseSeparations:     FloatW8,
	normalImpulses:      FloatW8,
	totalNormalImpulses: FloatW8,
	normalMasses:        FloatW8,
	leverArms:           FloatW8,
	relativeVelocities:  FloatW8,
	restitutionImpulses: FloatW8,
}

ContactManifoldW8 :: struct #align (WIDE_ALIGNMENT) {
	normal:           Vec3W8,
	tangent1:         Vec3W8,
	tangent2:         Vec3W8,

	// Friction centers
	centerA, centerB: Vec3W8,
	twistMass:        FloatW8,
	twistImpulse:     FloatW8,
	tangentMass:      SymMatrix2W8,
	frictionImpulse:  Vec2W8,
	rollingImpulse:   Vec3W8,
	rollingMask:      FloatW8,
	tangentVelocity1: FloatW8,
	tangentVelocity2: FloatW8,
	pointCount:       i32,
	points:           [MAX_MANIFOLD_POINTS]ContactConstraintPointW8,
}

// Solves one contact per lane
ContactConstraintW8 :: struct #align (WIDE_ALIGNMENT) {
	// These are base 1
	indexA:             [SIMD_WIDTH]i32,
	indexB:             [SIMD_WIDTH]i32,
	contacts:           [SIMD_WIDTH]^Contact,
	invMassA, invMassB: FloatW8,
	invIA, invIB:       SymMatrix3W8,
	rollingMass:        SymMatrix3W8,
	friction:           FloatW8,
	rollingResistance:  FloatW8,
	restitution:        FloatW8,
	manifoldCount:      i32,
}

ConvexConstraintW8 :: struct {
	base:     ContactConstraintW8,
	manifold: ContactManifoldW8,
}

#assert(offset_of(ConvexConstraintW8, manifold) == size_of(ContactConstraintW8), "wide constraint layout")
#assert(size_of(ContactConstraintW8) % WIDE_ALIGNMENT == 0, "wide constraint layout")
#assert(size_of(ContactManifoldW8) % WIDE_ALIGNMENT == 0, "wide constraint layout")

@(enable_target_feature = "avx2")
GetWideContactConstraintByteCountW8 :: proc() -> i32 {
	return i32(size_of(ConvexConstraintW8))
}

@(enable_target_feature = "avx2")
GetWideMeshConstraintByteCountW8 :: proc() -> i32 {
	return i32(size_of(ContactConstraintW8))
}

@(enable_target_feature = "avx2")
GetWideMeshManifoldByteCountW8 :: proc() -> i32 {
	return i32(size_of(ContactManifoldW8))
}

// wide version of b3BodyState
BodyStateW8 :: struct {
	v:  Vec3W8,
	w:  Vec3W8,
	dp: Vec3W8,
	dq: QuatW8,
}

// unified: not ported: the B3_SIMD_NONE b3GatherBodies and b3ScatterBodies (simd_scalar.h is not ported, simd.odin)

#assert(size_of(BodyState) == 64, "body state layout")
#assert(
	offset_of(BodyState, linearVelocity) == 0 &&
	offset_of(BodyState, angularVelocity) == 16 &&
	offset_of(BodyState, deltaPosition) == 32 &&
	offset_of(BodyState, deltaRotation) == 48,
	"body state layout",
)

when SIMD_WIDTH == 8 {
	@(private = "file", enable_target_feature = "avx2")
	GatherBodies :: #force_inline proc(states: [^]BodyState, indices: [^]i32) -> BodyStateW8 {
		identity := cast([^]f32)&identityBodyState

		// Indices are 0 for null
		p1 := indices[0] == 0 ? identity : cast([^]f32)&states[indices[0] - 1]
		p2 := indices[1] == 0 ? identity : cast([^]f32)&states[indices[1] - 1]
		p3 := indices[2] == 0 ? identity : cast([^]f32)&states[indices[2] - 1]
		p4 := indices[3] == 0 ? identity : cast([^]f32)&states[indices[3] - 1]
		p5 := indices[4] == 0 ? identity : cast([^]f32)&states[indices[4] - 1]
		p6 := indices[5] == 0 ? identity : cast([^]f32)&states[indices[5] - 1]
		p7 := indices[6] == 0 ? identity : cast([^]f32)&states[indices[6] - 1]
		p8 := indices[7] == 0 ? identity : cast([^]f32)&states[indices[7] - 1]

		s: BodyStateW8
		pad: FloatW8

		TransposeW8(
			LoadW8(p1),
			LoadW8(p2),
			LoadW8(p3),
			LoadW8(p4),
			LoadW8(p5),
			LoadW8(p6),
			LoadW8(p7),
			LoadW8(p8),
			&s.v.X,
			&s.v.Y,
			&s.v.Z,
			&pad,
			&s.w.X,
			&s.w.Y,
			&s.w.Z,
			&pad,
		)
		TransposeW8(
			LoadW8(p1[8:]),
			LoadW8(p2[8:]),
			LoadW8(p3[8:]),
			LoadW8(p4[8:]),
			LoadW8(p5[8:]),
			LoadW8(p6[8:]),
			LoadW8(p7[8:]),
			LoadW8(p8[8:]),
			&s.dp.X,
			&s.dp.Y,
			&s.dp.Z,
			&pad,
			&s.dq.V.X,
			&s.dq.V.Y,
			&s.dq.V.Z,
			&s.dq.S,
		)

		return s
	}

	@(private = "file", enable_target_feature = "avx2")
	StoreBodyVelocity :: #force_inline proc(states: [^]BodyState, index: i32, vw: FloatW8) {
		// Indices are 0 for null
		if index == 0 {
			return
		}

		state := &states[index - 1]
		flags := state.flags
		if (flags & dynamicFlag) == 0 {
			return
		}

		StoreW8(cast([^]f32)state, vw)
	}

	// This writes only the velocities back to the solver bodies
	@(private = "file", enable_target_feature = "avx2")
	ScatterBodies :: #force_inline proc(states: [^]BodyState, indices: [^]i32, simdBody: ^BodyStateW8) {
		// I don't use any dummy body in the body array because this will lead to multithreaded sharing and the
		// associated cache flushing.
		zero := ZeroW8()
		vw1, vw2, vw3, vw4, vw5, vw6, vw7, vw8: FloatW8
		TransposeW8(
			simdBody.v.X,
			simdBody.v.Y,
			simdBody.v.Z,
			zero,
			simdBody.w.X,
			simdBody.w.Y,
			simdBody.w.Z,
			zero,
			&vw1,
			&vw2,
			&vw3,
			&vw4,
			&vw5,
			&vw6,
			&vw7,
			&vw8,
		)

		StoreBodyVelocity(states, indices[0], vw1)
		StoreBodyVelocity(states, indices[1], vw2)
		StoreBodyVelocity(states, indices[2], vw3)
		StoreBodyVelocity(states, indices[3], vw4)
		StoreBodyVelocity(states, indices[4], vw5)
		StoreBodyVelocity(states, indices[5], vw6)
		StoreBodyVelocity(states, indices[6], vw7)
		StoreBodyVelocity(states, indices[7], vw8)
	}
} else {
	@(private = "file", enable_target_feature = "avx2")
	GatherBodies :: #force_inline proc(states: [^]BodyState, indices: [^]i32) -> BodyStateW8 {
		identity := cast([^]f32)&identityBodyState

		// Indices are 0 for null
		p1 := indices[0] == 0 ? identity : cast([^]f32)&states[indices[0] - 1]
		p2 := indices[1] == 0 ? identity : cast([^]f32)&states[indices[1] - 1]
		p3 := indices[2] == 0 ? identity : cast([^]f32)&states[indices[2] - 1]
		p4 := indices[3] == 0 ? identity : cast([^]f32)&states[indices[3] - 1]

		s: BodyStateW8
		pad: FloatW8
		TransposeW8(LoadW8(p1), LoadW8(p2), LoadW8(p3), LoadW8(p4), &s.v.X, &s.v.Y, &s.v.Z, &pad)
		TransposeW8(LoadW8(p1[4:]), LoadW8(p2[4:]), LoadW8(p3[4:]), LoadW8(p4[4:]), &s.w.X, &s.w.Y, &s.w.Z, &pad)
		TransposeW8(LoadW8(p1[8:]), LoadW8(p2[8:]), LoadW8(p3[8:]), LoadW8(p4[8:]), &s.dp.X, &s.dp.Y, &s.dp.Z, &pad)
		TransposeW8(
			LoadW8(p1[12:]),
			LoadW8(p2[12:]),
			LoadW8(p3[12:]),
			LoadW8(p4[12:]),
			&s.dq.V.X,
			&s.dq.V.Y,
			&s.dq.V.Z,
			&s.dq.S,
		)
		return s
	}

	@(private = "file", enable_target_feature = "avx2")
	StoreBodyVelocity :: #force_inline proc(states: [^]BodyState, index: i32, v: FloatW8, w: FloatW8) {
		// Indices are 0 for null
		if index == 0 {
			return
		}

		state := &states[index - 1]
		flags := state.flags
		if (flags & dynamicFlag) == 0 {
			return
		}

		StoreW8(cast([^]f32)state, v)
		StoreW8((cast([^]f32)state)[4:], w)
	}

	// This writes only the velocities back to the solver bodies
	@(private = "file", enable_target_feature = "avx2")
	ScatterBodies :: #force_inline proc(states: [^]BodyState, indices: [^]i32, simdBody: ^BodyStateW8) {
		// I don't use any dummy body in the body array because this will lead to multithreaded sharing and the
		// associated cache flushing.
		zero := ZeroW8()
		v1, v2, v3, v4: FloatW8
		TransposeW8(simdBody.v.X, simdBody.v.Y, simdBody.v.Z, zero, &v1, &v2, &v3, &v4)
		w1, w2, w3, w4: FloatW8
		TransposeW8(simdBody.w.X, simdBody.w.Y, simdBody.w.Z, zero, &w1, &w2, &w3, &w4)

		StoreBodyVelocity(states, indices[0], v1, w1)
		StoreBodyVelocity(states, indices[1], v2, w2)
		StoreBodyVelocity(states, indices[2], v3, w3)
		StoreBodyVelocity(states, indices[3], v4, w4)
	}
}

#assert(offset_of(ManifoldPoint, anchorA) == 0, "manifold point layout")
#assert(offset_of(ManifoldPoint, anchorB) == 12, "manifold point layout")
#assert(offset_of(ManifoldPoint, separation) == 24, "manifold point layout")
#assert(offset_of(ManifoldPoint, normalImpulse) == 28, "manifold point layout")
#assert(offset_of(Manifold, twistImpulse) == offset_of(Manifold, normal) + 12, "manifold layout")
#assert(offset_of(Manifold, frictionImpulse) == offset_of(Manifold, normal) + 16, "manifold layout")
#assert(offset_of(Manifold, rollingImpulse) == offset_of(Manifold, normal) + 28, "manifold layout")
#assert(offset_of(Manifold, pointCount) == offset_of(Manifold, normal) + 40, "manifold layout")
#assert(offset_of(Matrix3, cy) == 12 && offset_of(Matrix3, cz) == 24 && size_of(Matrix3) == 36, "matrix layout")

@(private = "file", rodata)
zeroContact := Contact{}
@(private = "file", rodata)
zeroManifold := Manifold{}
@(private = "file", rodata)
zeroBodySim := BodySim{}

// unified: the B3_GATHER_LANES macro (wide = b3SetW( lanes[0]->field, ..., lanes[last]->field )) is a proc taking
// the field's offset in T: it loads the gathered lanes, the value b3SetW makes.
@(private = "file", enable_target_feature = "avx2")
GatherLanes :: #force_inline proc(lanes: [^]^$T, $offset: uintptr) -> FloatW8 {
	values: [SIMD_WIDTH]f32 = ---
	#unroll for lane in 0 ..< SIMD_WIDTH {
		values[lane] = (^f32)(uintptr(lanes[lane]) + offset)^
	}
	return LoadW8(&values[0])
}
// unified end

@(private = "file", enable_target_feature = "avx2")
GatherInvInertiaW :: proc(simLanes: [^]^BodySim) -> SymMatrix3W8 {
	i0 := cast([^]f32)&simLanes[0].invInertiaWorld.cx.x
	i1 := cast([^]f32)&simLanes[1].invInertiaWorld.cx.x
	i2 := cast([^]f32)&simLanes[2].invInertiaWorld.cx.x
	i3 := cast([^]f32)&simLanes[3].invInertiaWorld.cx.x
	when SIMD_WIDTH == 8 {
		i4 := cast([^]f32)&simLanes[4].invInertiaWorld.cx.x
		i5 := cast([^]f32)&simLanes[5].invInertiaWorld.cx.x
		i6 := cast([^]f32)&simLanes[6].invInertiaWorld.cx.x
		i7 := cast([^]f32)&simLanes[7].invInertiaWorld.cx.x
	}

	m: SymMatrix3W8
	unused: FloatW8
	when SIMD_WIDTH == 8 {
		TransposeW8(
			LoadW8(i0),
			LoadW8(i1),
			LoadW8(i2),
			LoadW8(i3),
			LoadW8(i4),
			LoadW8(i5),
			LoadW8(i6),
			LoadW8(i7),
			&m.cxx,
			&m.cxy,
			&m.cxz,
			&unused,
			&m.cyy,
			&m.cyz,
			&unused,
			&unused,
		)
		m.czz = SetW8(i0[8], i1[8], i2[8], i3[8], i4[8], i5[8], i6[8], i7[8])
	} else {
		TransposeW8(LoadW8(i0), LoadW8(i1), LoadW8(i2), LoadW8(i3), &m.cxx, &m.cxy, &m.cxz, &unused)
		TransposeW8(LoadW8(i0[4:]), LoadW8(i1[4:]), LoadW8(i2[4:]), LoadW8(i3[4:]), &m.cyy, &m.cyz, &unused, &unused)
		m.czz = SetW8(i0[8], i1[8], i2[8], i3[8])
	}
	return m
}

@(private = "file", enable_target_feature = "avx2")
AddSymW :: proc(a: SymMatrix3W8, b: SymMatrix3W8) -> SymMatrix3W8 {
	return SymMatrix3W8 {
		AddW8(a.cxx, b.cxx),
		AddW8(a.cxy, b.cxy),
		AddW8(a.cxz, b.cxz),
		AddW8(a.cyy, b.cyy),
		AddW8(a.cyz, b.cyz),
		AddW8(a.czz, b.czz),
	}
}

@(private = "file", enable_target_feature = "avx2")
InvertSymW :: proc(m: SymMatrix3W8) -> SymMatrix3W8 {
	cxx := SubW8(MulW8(m.cyy, m.czz), MulW8(m.cyz, m.cyz))
	cxy := SubW8(MulW8(m.cxz, m.cyz), MulW8(m.cxy, m.czz))
	cxz := SubW8(MulW8(m.cxy, m.cyz), MulW8(m.cxz, m.cyy))
	cyy := SubW8(MulW8(m.cxx, m.czz), MulW8(m.cxz, m.cxz))
	cyz := SubW8(MulW8(m.cxy, m.cxz), MulW8(m.cxx, m.cyz))
	czz := SubW8(MulW8(m.cxx, m.cyy), MulW8(m.cxy, m.cxy))

	det := AddW8(MulW8(m.cxx, cxx), AddW8(MulW8(m.cxy, cxy), MulW8(m.cxz, cxz)))
	valid := GreaterThanW8(AbsW8(det), SplatW8(1000.0 * FLT_MIN))
	invDet := BlendW8(ZeroW8(), DivW8(SplatW8(1.0), det), valid)

	return SymMatrix3W8 {
		MulW8(invDet, cxx),
		MulW8(invDet, cxy),
		MulW8(invDet, cxz),
		MulW8(invDet, cyy),
		MulW8(invDet, cyz),
		MulW8(invDet, czz),
	}
}

@(private = "file", enable_target_feature = "avx2")
PerpW :: proc(a: Vec3W8) -> Vec3W8 {
	zero := ZeroW8()
	half := SplatW8(0.5)
	mask := OrW8(LessThanW8(a.X, NegW8(half)), GreaterThanW8(a.X, half))

	p: Vec3W8
	p.X = BlendW8(zero, a.Y, mask)
	p.Y = BlendW8(a.Z, NegW8(a.X), mask)
	p.Z = BlendW8(NegW8(a.Y), zero, mask)

	lengthSquared := DotW8(p, p)
	valid := GreaterThanW8(lengthSquared, SplatW8(1000.0 * FLT_MIN))
	s := BlendW8(zero, DivW8(SplatW8(1.0), SqrtW8(lengthSquared)), valid)
	return MulSVW8(s, p)
}
@(private = "file", enable_target_feature = "avx2")
IntsToFloatW :: proc(v: [^]i32) -> FloatW8 {
	when SIMD_WIDTH == 8 {
		return SetW8(f32(v[0]), f32(v[1]), f32(v[2]), f32(v[3]), f32(v[4]), f32(v[5]), f32(v[6]), f32(v[7]))
	} else {
		return SetW8(f32(v[0]), f32(v[1]), f32(v[2]), f32(v[3]))
	}
}

// Get the contiguous manifold array that trails the constraint.
@(private = "file", enable_target_feature = "avx2")
GetManifoldsW :: proc(c: ^ContactConstraintW8) -> [^]ContactManifoldW8 {
	return cast([^]ContactManifoldW8)(cast([^]ContactConstraintW8)c)[1:]
}

// fixedManifoldCount is 1 to indicate a convex contact with one manifold.
@(private = "file", enable_target_feature = "avx2")
GetConstraintW :: #force_inline proc(
	base: rawptr,
	manifoldStarts: [^]i32,
	index: i32,
	fixedManifoldCount: i32,
) -> ^ContactConstraintW8 {
	if fixedManifoldCount > 0 {
		stride := size_of(ContactConstraintW8) + int(fixedManifoldCount) * size_of(ContactManifoldW8)
		return cast(^ContactConstraintW8)&(cast([^]u8)base)[int(index) * stride]
	}

	offset :=
		int(index) * size_of(ContactConstraintW8) +
		int(manifoldStarts[index] - manifoldStarts[0]) * size_of(ContactManifoldW8)
	return cast(^ContactConstraintW8)&(cast([^]u8)base)[offset]
}

@(private = "file", enable_target_feature = "avx2")
NextConstraintW :: #force_inline proc(c: ^ContactConstraintW8, manifoldCount: i32) -> ^ContactConstraintW8 {
	offset := size_of(ContactConstraintW8) + int(manifoldCount) * size_of(ContactManifoldW8)
	return cast(^ContactConstraintW8)&(cast([^]u8)c)[offset]
}

// Contact constraint data is stored in a heterogious stream. Constraints followed by an array of constraint manifolds.
// [c1 m11 m12 c2 m21 c3 m31 m32 m33 ... ]
@(private = "file", enable_target_feature = "avx2")
PrepareConstraintW :: #force_inline proc(
	c: ^ContactConstraintW8,
	contacts: [^]^Contact,
	manifoldCount: i32,
	context_: ^StepContext,
	warmStartScale: FloatW8,
) -> bool {
	sims := context_.sims
	states := context_.states
	when ENABLE_VALIDATION {
		bodies := context_.world.bodies.data
	}

	zeroW := ZeroW8()
	oneW := SplatW8(1.0)
	twoW := SplatW8(2.0)
	invTau := SplatW8(1.0 / SPECULATIVE_DISTANCE)
	minFrictionWeight := SplatW8(MIN_FRICTION_WEIGHT)
	minDet := SplatW8(1000.0 * FLT_MIN)

	contactLanes: [SIMD_WIDTH]^Contact
	simLanesA: [SIMD_WIDTH]^BodySim
	simLanesB: [SIMD_WIDTH]^BodySim
	manifoldCounts: [SIMD_WIDTH]i32
	hitEventLanes: i32 = 0
	maxManifoldCount: i32 = 0

	for lane: i32 = 0; lane < SIMD_WIDTH; lane += 1 {
		contact := contacts[lane]
		c.contacts[lane] = contact

		if contact != nil {
			indexA := DecodeAwakeIndex(contact.encodedBodySimA)
			indexB := DecodeAwakeIndex(contact.encodedBodySimB)

			when ENABLE_VALIDATION {
				bodyA := &bodies[contact.edges[0].bodyId]
				bodyB := &bodies[contact.edges[1].bodyId]
				assert(contact.encodedBodySimA == EncodeBodySimIndex(bodyA))
				assert(contact.encodedBodySimB == EncodeBodySimIndex(bodyB))
			}

			c.indexA[lane] = indexA + 1
			c.indexB[lane] = indexB + 1
			manifoldCounts[lane] = contact.manifoldCount

			contactLanes[lane] = contact
			simLanesA[lane] = indexA == NULL_INDEX ? &zeroBodySim : &sims[indexA]
			simLanesB[lane] = indexB == NULL_INDEX ? &zeroBodySim : &sims[indexB]
			hitEventLanes |= (contact.flags & simEnableHitEvent) != 0 ? i32(1) << u32(lane) : 0
			maxManifoldCount = MaxInt(maxManifoldCount, contact.manifoldCount)
		} else {
			c.indexA[lane] = 0
			c.indexB[lane] = 0
			manifoldCounts[lane] = 0

			contactLanes[lane] = &zeroContact
			simLanesA[lane] = &zeroBodySim
			simLanesB[lane] = &zeroBodySim
		}
	}

	VALIDATE(maxManifoldCount == manifoldCount)
	_ = maxManifoldCount
	c.manifoldCount = manifoldCount

	mA, mB: FloatW8
	mA = GatherLanes(&simLanesA[0], offset_of(BodySim, invMass))
	mB = GatherLanes(&simLanesB[0], offset_of(BodySim, invMass))
	iA := GatherInvInertiaW(&simLanesA[0])
	iB := GatherInvInertiaW(&simLanesB[0])
	c.invMassA = mA
	c.invMassB = mB
	c.invIA = iA
	c.invIB = iB

	tangentVelocity: Vec3W8
	c.friction = GatherLanes(&contactLanes[0], offset_of(Contact, friction))
	c.rollingResistance = GatherLanes(&contactLanes[0], offset_of(Contact, rollingResistance))
	c.restitution = GatherLanes(&contactLanes[0], offset_of(Contact, restitution))
	tangentVelocity.X = GatherLanes(&contactLanes[0], offset_of(Contact, tangentVelocity) + offset_of(Vec3, x))
	tangentVelocity.Y = GatherLanes(&contactLanes[0], offset_of(Contact, tangentVelocity) + offset_of(Vec3, y))
	tangentVelocity.Z = GatherLanes(&contactLanes[0], offset_of(Contact, tangentVelocity) + offset_of(Vec3, z))

	invIAB := AddSymW(iA, iB)
	if AllZeroW8(c.rollingResistance) == false {
		c.rollingMass = InvertSymW(invIAB)
	} else {
		c.rollingMass = SymMatrix3W8{zeroW, zeroW, zeroW, zeroW, zeroW, zeroW}
	}

	rollingResistanceMask := GreaterThanW8(c.rollingResistance, zeroW)

	manifolds := GetManifoldsW(c)
	for manifoldIndex: i32 = 0; manifoldIndex < manifoldCount; manifoldIndex += 1 {
		cm := &manifolds[manifoldIndex]

		manifoldLanes: [SIMD_WIDTH]^Manifold
		activeLanes: [SIMD_WIDTH]i32
		pointCounts: [SIMD_WIDTH]i32
		pointCount: i32 = 0
		for lane: i32 = 0; lane < SIMD_WIDTH; lane += 1 {
			if manifoldIndex < manifoldCounts[lane] {
				manifold := &contactLanes[lane].manifolds[manifoldIndex]
				manifoldLanes[lane] = manifold
				activeLanes[lane] = 1
				pointCounts[lane] = manifold.pointCount
			} else {
				manifoldLanes[lane] = &zeroManifold
				activeLanes[lane] = 0
				pointCounts[lane] = 0
			}

			pointCount = MaxInt(pointCount, pointCounts[lane])
		}

		VALIDATE(0 <= pointCount && pointCount <= MAX_MANIFOLD_POINTS)
		cm.pointCount = pointCount
		cm.rollingMask = AndW8(rollingResistanceMask, GreaterThanW8(IntsToFloatW(&activeLanes[0]), zeroW))

		normal, frictionImpulse, rollingImpulse: Vec3W8
		twistImpulse: FloatW8
		{
			m0 := cast([^]f32)&manifoldLanes[0].normal.x
			m1 := cast([^]f32)&manifoldLanes[1].normal.x
			m2 := cast([^]f32)&manifoldLanes[2].normal.x
			m3 := cast([^]f32)&manifoldLanes[3].normal.x
			when SIMD_WIDTH == 8 {
				m4 := cast([^]f32)&manifoldLanes[4].normal.x
				m5 := cast([^]f32)&manifoldLanes[5].normal.x
				m6 := cast([^]f32)&manifoldLanes[6].normal.x
				m7 := cast([^]f32)&manifoldLanes[7].normal.x
				TransposeW8(
					LoadW8(m0),
					LoadW8(m1),
					LoadW8(m2),
					LoadW8(m3),
					LoadW8(m4),
					LoadW8(m5),
					LoadW8(m6),
					LoadW8(m7),
					&normal.X,
					&normal.Y,
					&normal.Z,
					&twistImpulse,
					&frictionImpulse.X,
					&frictionImpulse.Y,
					&frictionImpulse.Z,
					&rollingImpulse.X,
				)
				rollingImpulse.Y = SetW8(m0[8], m1[8], m2[8], m3[8], m4[8], m5[8], m6[8], m7[8])
				rollingImpulse.Z = SetW8(m0[9], m1[9], m2[9], m3[9], m4[9], m5[9], m6[9], m7[9])
			} else {
				TransposeW8(LoadW8(m0), LoadW8(m1), LoadW8(m2), LoadW8(m3), &normal.X, &normal.Y, &normal.Z, &twistImpulse)
				TransposeW8(
					LoadW8(m0[4:]),
					LoadW8(m1[4:]),
					LoadW8(m2[4:]),
					LoadW8(m3[4:]),
					&frictionImpulse.X,
					&frictionImpulse.Y,
					&frictionImpulse.Z,
					&rollingImpulse.X,
				)
				rollingImpulse.Y = SetW8(m0[8], m1[8], m2[8], m3[8])
				rollingImpulse.Z = SetW8(m0[9], m1[9], m2[9], m3[9])
			}
		}

		tangent1 := PerpW(normal)
		tangent2 := CrossW8(tangent1, normal)
		cm.normal = normal
		cm.tangent1 = tangent1
		cm.tangent2 = tangent2
		cm.tangentVelocity1 = DotW8(tangentVelocity, tangent1)
		cm.tangentVelocity2 = DotW8(tangentVelocity, tangent2)

		cm.twistImpulse = MulW8(warmStartScale, twistImpulse)
		cm.rollingImpulse.X = BlendW8(zeroW, MulW8(warmStartScale, rollingImpulse.X), cm.rollingMask)
		cm.rollingImpulse.Y = BlendW8(zeroW, MulW8(warmStartScale, rollingImpulse.Y), cm.rollingMask)
		cm.rollingImpulse.Z = BlendW8(zeroW, MulW8(warmStartScale, rollingImpulse.Z), cm.rollingMask)
		cm.frictionImpulse.x = MulW8(warmStartScale, DotW8(frictionImpulse, tangent1))
		cm.frictionImpulse.y = MulW8(warmStartScale, DotW8(frictionImpulse, tangent2))

		pointCountW := IntsToFloatW(&pointCounts[0])

		centerA := Vec3W8{zeroW, zeroW, zeroW}
		centerB := Vec3W8{zeroW, zeroW, zeroW}
		totalFrictionWeight := zeroW

		for pointIndex: i32 = 0; pointIndex < pointCount; pointIndex += 1 {
			cp := &cm.points[pointIndex]
			pointMask := GreaterThanW8(pointCountW, SplatW8(f32(pointIndex)))

			p0 := cast([^]f32)&manifoldLanes[0].points[pointIndex]
			p1 := cast([^]f32)&manifoldLanes[1].points[pointIndex]
			p2 := cast([^]f32)&manifoldLanes[2].points[pointIndex]
			p3 := cast([^]f32)&manifoldLanes[3].points[pointIndex]
			when SIMD_WIDTH == 8 {
				p4 := cast([^]f32)&manifoldLanes[4].points[pointIndex]
				p5 := cast([^]f32)&manifoldLanes[5].points[pointIndex]
				p6 := cast([^]f32)&manifoldLanes[6].points[pointIndex]
				p7 := cast([^]f32)&manifoldLanes[7].points[pointIndex]
			}

			rA, rB: Vec3W8
			separation, normalImpulse: FloatW8
			when SIMD_WIDTH == 8 {
				TransposeW8(
					LoadW8(p0),
					LoadW8(p1),
					LoadW8(p2),
					LoadW8(p3),
					LoadW8(p4),
					LoadW8(p5),
					LoadW8(p6),
					LoadW8(p7),
					&rA.X,
					&rA.Y,
					&rA.Z,
					&rB.X,
					&rB.Y,
					&rB.Z,
					&separation,
					&normalImpulse,
				)
			} else {
				TransposeW8(LoadW8(p0), LoadW8(p1), LoadW8(p2), LoadW8(p3), &rA.X, &rA.Y, &rA.Z, &rB.X)
				TransposeW8(
					LoadW8(p0[4:]),
					LoadW8(p1[4:]),
					LoadW8(p2[4:]),
					LoadW8(p3[4:]),
					&rB.Y,
					&rB.Z,
					&separation,
					&normalImpulse,
				)
			}

			rA.X = BlendW8(zeroW, rA.X, pointMask)
			rA.Y = BlendW8(zeroW, rA.Y, pointMask)
			rA.Z = BlendW8(zeroW, rA.Z, pointMask)
			rB.X = BlendW8(zeroW, rB.X, pointMask)
			rB.Y = BlendW8(zeroW, rB.Y, pointMask)
			rB.Z = BlendW8(zeroW, rB.Z, pointMask)
			separation = BlendW8(zeroW, separation, pointMask)
			normalImpulse = BlendW8(zeroW, normalImpulse, pointMask)

			// C0 friction center decay. Needed to prevent spinning top drift (GyroscopicPrecession sample).
			// See details in b3PrepareContacts_Mesh. This code should stay in sync.
			weight := MinW8(MaxW8(SubW8(twoW, MulW8(separation, invTau)), minFrictionWeight), oneW)
			weight = BlendW8(zeroW, weight, pointMask)
			centerA = MulAddSVW8(centerA, weight, rA)
			centerB = MulAddSVW8(centerB, weight, rB)
			totalFrictionWeight = AddW8(totalFrictionWeight, weight)

			cp.anchorAs = rA
			cp.anchorBs = rB
			cp.baseSeparations = SubW8(separation, DotW8(SubVW8(rB, rA), normal))
			cp.normalImpulses = MulW8(warmStartScale, normalImpulse)
			cp.totalNormalImpulses = zeroW
			cp.relativeVelocities = zeroW
			cp.restitutionImpulses = zeroW

			rnA := CrossW8(rA, normal)
			rnB := CrossW8(rB, normal)
			kNormal := AddW8(mA, mB)
			kNormal = AddW8(kNormal, DotW8(rnA, MulMVW(iA, rnA)))
			kNormal = AddW8(kNormal, DotW8(rnB, MulMVW(iB, rnB)))
			valid := AndW8(GreaterThanW8(kNormal, zeroW), pointMask)
			cp.normalMasses = BlendW8(zeroW, DivW8(oneW, kNormal), valid)
		}

		frictionValid := GreaterThanW8(totalFrictionWeight, zeroW)
		invWeight := BlendW8(zeroW, DivW8(oneW, totalFrictionWeight), frictionValid)
		centerA = MulSVW8(invWeight, centerA)
		centerB = MulSVW8(invWeight, centerB)
		cm.centerA = centerA
		cm.centerB = centerB

		for pointIndex: i32 = 0; pointIndex < pointCount; pointIndex += 1 {
			cp := &cm.points[pointIndex]
			pointMask := GreaterThanW8(pointCountW, SplatW8(f32(pointIndex)))
			d := SubVW8(cp.anchorAs, centerA)
			cp.leverArms = BlendW8(zeroW, SqrtW8(DotW8(d, d)), pointMask)
		}

		{
			rtA1 := CrossW8(centerA, tangent1)
			rtA2 := CrossW8(centerA, tangent2)
			rtB1 := CrossW8(centerB, tangent1)
			rtB2 := CrossW8(centerB, tangent2)
			iArtA1 := MulMVW(iA, rtA1)
			iArtA2 := MulMVW(iA, rtA2)
			iBrtB1 := MulMVW(iB, rtB1)
			iBrtB2 := MulMVW(iB, rtB2)

			kxx := AddW8(AddW8(AddW8(mA, mB), DotW8(rtA1, iArtA1)), DotW8(rtB1, iBrtB1))
			kyy := AddW8(AddW8(AddW8(mA, mB), DotW8(rtA2, iArtA2)), DotW8(rtB2, iBrtB2))
			kxy := AddW8(DotW8(rtA1, iArtA2), DotW8(rtB1, iBrtB2))

			det := SubW8(MulW8(kxx, kyy), MulW8(kxy, kxy))
			valid := AndW8(GreaterThanW8(AbsW8(det), minDet), frictionValid)
			invDet := BlendW8(zeroW, DivW8(oneW, det), valid)
			cm.tangentMass.cxx = MulW8(invDet, kyy)
			cm.tangentMass.cxy = NegW8(MulW8(invDet, kxy))
			cm.tangentMass.cyy = MulW8(invDet, kxx)
		}

		{
			kTwist := DotW8(normal, MulMVW(invIAB, normal))
			cm.twistMass = BlendW8(zeroW, DivW8(oneW, kTwist), GreaterThanW8(kTwist, zeroW))
		}
	}

	// Only sample contact point normal velocity if needed.
	haveRestitution := AnyTrueW8(GreaterThanW8(c.restitution, zeroW))
	if hitEventLanes != 0 || haveRestitution {
		bA := GatherBodies(states, &c.indexA[0])
		bB := GatherBodies(states, &c.indexB[0])

		for manifoldIndex: i32 = 0; manifoldIndex < manifoldCount; manifoldIndex += 1 {
			cm := &manifolds[manifoldIndex]

			for pointIndex: i32 = 0; pointIndex < cm.pointCount; pointIndex += 1 {
				cp := &cm.points[pointIndex]

				vrA := AddVW8(bA.v, CrossW8(bA.w, cp.anchorAs))
				vrB := AddVW8(bB.v, CrossW8(bB.w, cp.anchorBs))
				vn := DotW8(cm.normal, SubVW8(vrB, vrA))
				cp.relativeVelocities = vn

				if hitEventLanes != 0 {
					normalVelocities: [SIMD_WIDTH]f32
					StoreW8(&normalVelocities[0], vn)

					for lane: i32 = 0; lane < SIMD_WIDTH; lane += 1 {
						if (hitEventLanes & (i32(1) << u32(lane))) == 0 || manifoldIndex >= manifoldCounts[lane] {
							continue
						}

						manifold := &c.contacts[lane].manifolds[manifoldIndex]
						if pointIndex < manifold.pointCount {
							manifold.points[pointIndex].normalVelocity = normalVelocities[lane]
						}
					}
				}
			}
		}
	}

	return haveRestitution
}

@(enable_target_feature = "avx2")
PrepareContacts_ConvexW8 :: proc(block: SolverBlock, context_: ^StepContext) {
	world := context_.world
	spans := context_.widePrepareSpans
	wideBase := context_.wideConstraints
	warmStartScale := world.enableWarmStarting ? SplatW8(1.0) : ZeroW8()
	anyRestitution := false

	wideIndex := block.startIndex
	endWideIndex := block.startIndex + i32(block.count)

	// Find color for start index. Linear search but fast.
	colorIndex: i32 = 0
	for spans[colorIndex + 1].start <= wideIndex {
		colorIndex += 1
	}

	// Loop over block
	for wideIndex < endWideIndex {
		colorWideStart := spans[colorIndex].start
		colorWideEndIndex := MinInt(spans[colorIndex + 1].start, endWideIndex)
		colorContactCount := spans[colorIndex].count
		contactIds := spans[colorIndex].contacts

		// Loop over color
		for ; wideIndex < colorWideEndIndex; wideIndex += 1 {
			c := GetConstraintW(wideBase, nil, wideIndex, 1)
			localWideIndex := wideIndex - colorWideStart

			contacts: [SIMD_WIDTH]^Contact
			for lane: i32 = 0; lane < SIMD_WIDTH; lane += 1 {
				contactIndex := SIMD_WIDTH * localWideIndex + lane
				if contactIndex < colorContactCount {
					contacts[lane] = Array_Get(&world.contacts, contactIds[contactIndex])
					assert(contacts[lane].manifoldCount == 1)
				} else {
					contacts[lane] = nil
				}
			}

			haveRestitution := PrepareConstraintW(c, &contacts[0], 1, context_, warmStartScale)
			anyRestitution = anyRestitution || haveRestitution
		}

		// Advance to next color
		colorIndex += 1
	}

	if anyRestitution {
		AtomicStoreInt(&context_.anyRestitution, 1)
	}
}

@(enable_target_feature = "avx2")
PrepareContacts_MeshWideW8 :: proc(block: SolverBlock, context_: ^StepContext) {
	world := context_.world
	spans := context_.meshPrepareSpans
	wideBase := context_.wideMeshConstraints
	manifoldStarts := context_.wideMeshManifoldStarts
	warmStartScale := world.enableWarmStarting ? SplatW8(1.0) : ZeroW8()
	anyRestitution := false

	wideIndex := block.startIndex
	endWideIndex := block.startIndex + i32(block.count)

	colorIndex: i32 = 0
	for spans[colorIndex + 1].start <= wideIndex {
		colorIndex += 1
	}

	for wideIndex < endWideIndex {
		colorWideStart := spans[colorIndex].start
		colorWideEndIndex := MinInt(spans[colorIndex + 1].start, endWideIndex)
		colorContactCount := spans[colorIndex].count
		specs := spans[colorIndex].contacts

		// This order is used to group contacts with similar manifold counts to keep the lanes full.
		order := spans[colorIndex].order

		for ; wideIndex < colorWideEndIndex; wideIndex += 1 {
			c := GetConstraintW(wideBase, manifoldStarts, wideIndex, 0)
			localWideIndex := wideIndex - colorWideStart

			contacts: [SIMD_WIDTH]^Contact
			for lane: i32 = 0; lane < SIMD_WIDTH; lane += 1 {
				contactIndex := SIMD_WIDTH * localWideIndex + lane
				if contactIndex < colorContactCount {
					spec := &specs[order[contactIndex]]
					contact := Array_Get(&world.contacts, spec.contactId)
					assert(contact.contactId == spec.contactId)
					assert(contact.manifoldCount == i32(spec.manifoldCount))
					contacts[lane] = contact
				} else {
					contacts[lane] = nil
				}
			}

			manifoldCount := manifoldStarts[wideIndex + 1] - manifoldStarts[wideIndex]
			haveRestitution := PrepareConstraintW(c, &contacts[0], manifoldCount, context_, warmStartScale)
			anyRestitution = anyRestitution || haveRestitution
		}

		colorIndex += 1
	}

	if anyRestitution {
		AtomicStoreInt(&context_.anyRestitution, 1)
	}
}

@(private = "file", enable_target_feature = "avx2")
WarmStartContactsW :: #force_inline proc(
	block: SolverBlock,
	context_: ^StepContext,
	base: rawptr,
	manifoldStarts: [^]i32,
	fixedManifoldCount: i32,
) {
	states := context_.states
	zeroW := ZeroW8()

	c := GetConstraintW(base, manifoldStarts, block.startIndex, fixedManifoldCount)
	for i: i32 = 0; i < i32(block.count); i += 1 {
		manifoldCount := fixedManifoldCount > 0 ? fixedManifoldCount : c.manifoldCount
		anyRolling := AllZeroW8(c.rollingResistance) == false

		linearImpulse := Vec3W8{zeroW, zeroW, zeroW}
		angularImpulseA := Vec3W8{zeroW, zeroW, zeroW}
		angularImpulseB := Vec3W8{zeroW, zeroW, zeroW}

		manifolds := GetManifoldsW(c)
		for manifoldIndex: i32 = 0; manifoldIndex < manifoldCount; manifoldIndex += 1 {
			cm := &manifolds[manifoldIndex]

			totalNormalImpulse := zeroW
			momentA := Vec3W8{zeroW, zeroW, zeroW}
			momentB := Vec3W8{zeroW, zeroW, zeroW}

			for pointIndex: i32 = 0; pointIndex < cm.pointCount; pointIndex += 1 {
				cp := &cm.points[pointIndex]
				normalImpulse := cp.normalImpulses
				totalNormalImpulse = AddW8(totalNormalImpulse, normalImpulse)
				momentA = MulAddSVW8(momentA, normalImpulse, cp.anchorAs)
				momentB = MulAddSVW8(momentB, normalImpulse, cp.anchorBs)
			}

			normal := cm.normal
			frictionImpulse := MulSVW8(cm.frictionImpulse.x, cm.tangent1)
			frictionImpulse = MulAddSVW8(frictionImpulse, cm.frictionImpulse.y, cm.tangent2)

			linear := MulAddSVW8(frictionImpulse, totalNormalImpulse, normal)

			twistImpulse := MulSVW8(cm.twistImpulse, normal)
			angularA := AddVW8(AddVW8(CrossW8(momentA, normal), CrossW8(cm.centerA, frictionImpulse)), twistImpulse)
			angularB := AddVW8(AddVW8(CrossW8(momentB, normal), CrossW8(cm.centerB, frictionImpulse)), twistImpulse)

			if anyRolling {
				angularA = AddVW8(angularA, cm.rollingImpulse)
				angularB = AddVW8(angularB, cm.rollingImpulse)
			}

			linearImpulse = AddVW8(linearImpulse, linear)
			angularImpulseA = AddVW8(angularImpulseA, angularA)
			angularImpulseB = AddVW8(angularImpulseB, angularB)
		}

		bA := GatherBodies(states, &c.indexA[0])
		bB := GatherBodies(states, &c.indexB[0])

		bA.w = MulSubMVW(bA.w, c.invIA, angularImpulseA)
		bA.v = MulSubSVW8(bA.v, c.invMassA, linearImpulse)
		bB.w = MulAddMVW(bB.w, c.invIB, angularImpulseB)
		bB.v = MulAddSVW8(bB.v, c.invMassB, linearImpulse)

		ScatterBodies(states, &c.indexA[0], &bA)
		ScatterBodies(states, &c.indexB[0], &bB)

		c = NextConstraintW(c, manifoldCount)
	}
}

// Solve the non-penetration constraints with the soft bias. No friction and no restitution.
@(private = "file", enable_target_feature = "avx2")
PushContactsW :: #force_inline proc(
	block: SolverBlock,
	context_: ^StepContext,
	base: rawptr,
	manifoldStarts: [^]i32,
	fixedManifoldCount: i32,
) {
	states := context_.states
	inv_h := SplatW8(context_.inv_h)
	contactSpeed := SplatW8(-context_.world.contactSpeed)
	oneW := SplatW8(1.0)
	zeroW := ZeroW8()

	// Stiffer for static contacts to avoid bodies getting pushed through the ground. Selected per
	// lane from the null body index instead of stored per constraint.
	dynamicBiasRate := SplatW8(context_.contactSoftness.massScale * context_.contactSoftness.biasRate)
	dynamicMassScale := SplatW8(context_.contactSoftness.massScale)
	dynamicImpulseScale := SplatW8(context_.contactSoftness.impulseScale)
	staticBiasRate := SplatW8(context_.staticSoftness.massScale * context_.staticSoftness.biasRate)
	staticMassScale := SplatW8(context_.staticSoftness.massScale)
	staticImpulseScale := SplatW8(context_.staticSoftness.impulseScale)

	c := GetConstraintW(base, manifoldStarts, block.startIndex, fixedManifoldCount)
	for i: i32 = 0; i < i32(block.count); i += 1 {
		manifoldCount := fixedManifoldCount > 0 ? fixedManifoldCount : c.manifoldCount
		bA := GatherBodies(states, &c.indexA[0])
		bB := GatherBodies(states, &c.indexB[0])

		softMask := SoftMaskW8(&c.indexA[0], &c.indexB[0])
		biasRate := BlendW8(dynamicBiasRate, staticBiasRate, softMask)
		massScale := BlendW8(dynamicMassScale, staticMassScale, softMask)
		impulseScale := BlendW8(dynamicImpulseScale, staticImpulseScale, softMask)

		dp := SubVW8(bB.dp, bA.dp)
		invMass := AddW8(c.invMassA, c.invMassB)

		manifolds := GetManifoldsW(c)
		for manifoldIndex: i32 = 0; manifoldIndex < manifoldCount; manifoldIndex += 1 {
			cm := &manifolds[manifoldIndex]

			// Convert to normals to local space to reduce transform math.
			// Read the normal rather than put on stack to avoid register spills.
			normalSeparation := DotW8(cm.normal, dp)
			normalA := InvRotateVectorW(bA.dq, cm.normal)
			normalB := InvRotateVectorW(bB.dq, cm.normal)

			linearNormalVelocity := DotW8(cm.normal, SubVW8(bB.v, bA.v))
			manifoldImpulse := zeroW

			for pointIndex: i32 = 0; pointIndex < cm.pointCount; pointIndex += 1 {
				cp := &cm.points[pointIndex]

				// Fixed anchor points for applying impulses
				rA := cp.anchorAs
				rB := cp.anchorBs

				s := AddW8(AddW8(normalSeparation, SubW8(DotW8(normalB, rB), DotW8(normalA, rA))), cp.baseSeparations)

				// Apply speculative bias if separation is greater than zero, otherwise apply soft constraint bias
				separated := GreaterThanW8(s, zeroW)

				// Speculative bias - positive
				specBias := MulW8(s, inv_h)

				// Overlap bias - negative
				overlapBias := MaxW8(MulW8(biasRate, s), contactSpeed)
				velocityBias := BlendW8(overlapBias, specBias, separated)

				pointMassScale := BlendW8(massScale, oneW, separated)
				pointImpulseScale := BlendW8(impulseScale, zeroW, separated)

				uA := CrossW8(rA, cm.normal)
				uB := CrossW8(rB, cm.normal)
				gA := MulMVW(c.invIA, uA)
				gB := MulMVW(c.invIB, uB)

				vn := AddW8(linearNormalVelocity, SubW8(DotW8(uB, bB.w), DotW8(uA, bA.w)))

				negImpulse := AddW8(
					MulW8(cp.normalMasses, AddW8(MulW8(pointMassScale, vn), velocityBias)),
					MulW8(pointImpulseScale, cp.normalImpulses),
				)
				impulse := MaxW8(NegW8(negImpulse), NegW8(cp.normalImpulses))
				cp.normalImpulses = AddW8(cp.normalImpulses, impulse)

				linearNormalVelocity = MulAddW8(linearNormalVelocity, invMass, impulse)
				manifoldImpulse = AddW8(manifoldImpulse, impulse)
				bA.w = MulSubSVW8(bA.w, impulse, gA)
				bB.w = MulAddSVW8(bB.w, impulse, gB)
			}

			P := MulSVW8(manifoldImpulse, cm.normal)
			bA.v = MulSubSVW8(bA.v, c.invMassA, P)
			bB.v = MulAddSVW8(bB.v, c.invMassB, P)
		}

		ScatterBodies(states, &c.indexA[0], &bA)
		ScatterBodies(states, &c.indexB[0], &bB)

		c = NextConstraintW(c, manifoldCount)
	}
}

// Solve the normal constraint, friction, and rolling resistance.
@(private = "file", enable_target_feature = "avx2")
SolveContactsW :: #force_inline proc(
	block: SolverBlock,
	context_: ^StepContext,
	base: rawptr,
	manifoldStarts: [^]i32,
	fixedManifoldCount: i32,
) {
	states := context_.states
	inv_h := SplatW8(context_.inv_h)
	oneW := SplatW8(1.0)
	zeroW := ZeroW8()
	epsilonW := SplatW8(FLT_EPSILON)

	c := GetConstraintW(base, manifoldStarts, block.startIndex, fixedManifoldCount)
	for i: i32 = 0; i < i32(block.count); i += 1 {
		manifoldCount := fixedManifoldCount > 0 ? fixedManifoldCount : c.manifoldCount
		bA := GatherBodies(states, &c.indexA[0])
		bB := GatherBodies(states, &c.indexB[0])

		anyRolling := AllZeroW8(c.rollingResistance) == false
		dp := SubVW8(bB.dp, bA.dp)
		invMass := AddW8(c.invMassA, c.invMassB)

		manifolds := GetManifoldsW(c)
		for manifoldIndex: i32 = 0; manifoldIndex < manifoldCount; manifoldIndex += 1 {
			cm := &manifolds[manifoldIndex]

			// Read the normal rather than put on stack to avoid register spills.
			normalSeparation := DotW8(cm.normal, dp)
			normalA := InvRotateVectorW(bA.dq, cm.normal)
			normalB := InvRotateVectorW(bB.dq, cm.normal)

			dv := SubVW8(bB.v, bA.v)
			linearNormalVelocity := DotW8(cm.normal, dv)
			linearTangentVelocity1 := SubW8(DotW8(cm.tangent1, dv), cm.tangentVelocity1)
			linearTangentVelocity2 := SubW8(DotW8(cm.tangent2, dv), cm.tangentVelocity2)
			manifoldImpulse := zeroW

			totalNormalImpulse := zeroW
			totalTwistLimit := zeroW

			// Normal contraints
			for pointIndex: i32 = 0; pointIndex < cm.pointCount; pointIndex += 1 {
				cp := &cm.points[pointIndex]

				// Fixed anchor points for applying impulses
				rA := cp.anchorAs
				rB := cp.anchorBs

				s := AddW8(AddW8(normalSeparation, SubW8(DotW8(normalB, rB), DotW8(normalA, rA))), cp.baseSeparations)

				// Speculative bias, positive if separated and zero if overlapped
				velocityBias := MaxW8(zeroW, MulW8(s, inv_h))

				uA := CrossW8(rA, cm.normal)
				uB := CrossW8(rB, cm.normal)
				gA := MulMVW(c.invIA, uA)
				gB := MulMVW(c.invIB, uB)

				vn := AddW8(linearNormalVelocity, SubW8(DotW8(uB, bB.w), DotW8(uA, bA.w)))

				negImpulse := MulW8(cp.normalMasses, AddW8(vn, velocityBias))
				impulse := MaxW8(NegW8(negImpulse), NegW8(cp.normalImpulses))
				newImpulse := AddW8(cp.normalImpulses, impulse)
				cp.normalImpulses = newImpulse
				cp.totalNormalImpulses = AddW8(cp.totalNormalImpulses, newImpulse)
				totalNormalImpulse = AddW8(totalNormalImpulse, newImpulse)
				totalTwistLimit = AddW8(totalTwistLimit, MulW8(cp.leverArms, newImpulse))

				linearNormalVelocity = MulAddW8(linearNormalVelocity, invMass, impulse)
				manifoldImpulse = AddW8(manifoldImpulse, impulse)
				bA.w = MulSubSVW8(bA.w, impulse, gA)
				bB.w = MulAddSVW8(bB.w, impulse, gB)
			}

			// Rolling resistance. After normal constraints because it uses the normal impulse.
			if anyRolling {
				// flip A/B order to negate
				deltaImpulse := MulMVW(c.rollingMass, SubVW8(bA.w, bB.w))
				oldImpulse := cm.rollingImpulse
				cm.rollingImpulse = AddVW8(oldImpulse, deltaImpulse)

				maxImpulse := MulW8(c.rollingResistance, totalNormalImpulse)
				lengthSquared := DotW8(cm.rollingImpulse, cm.rollingImpulse)

				// if ( magSqr > maxLambda * maxLambda + FLT_EPSILON )
				//{
				//	c->rollingImpulse *= maxLambda / sqrtf( magSqr );
				// }

				mask := GreaterThanW8(lengthSquared, MulAddW8(epsilonW, maxImpulse, maxImpulse))

				// No approximate _mm_rsqrt_ps here to maintain cross-platform determinism
				normalize := DivW8(maxImpulse, AddW8(SqrtW8(lengthSquared), epsilonW))
				scale := BlendW8(oneW, normalize, mask)

				// Blend the result to ensure there are no +/-0 determinism problems, since 0 * -1 == -0.
				scaledImpulse := MulSVW8(scale, cm.rollingImpulse)
				cm.rollingImpulse.X = BlendW8(zeroW, scaledImpulse.X, cm.rollingMask)
				cm.rollingImpulse.Y = BlendW8(zeroW, scaledImpulse.Y, cm.rollingMask)
				cm.rollingImpulse.Z = BlendW8(zeroW, scaledImpulse.Z, cm.rollingMask)

				deltaImpulse = SubVW8(cm.rollingImpulse, oldImpulse)

				bA.w = MulSubMVW(bA.w, c.invIA, deltaImpulse)
				bB.w = MulAddMVW(bB.w, c.invIB, deltaImpulse)
			}

			// Central twist friction. Friction goes last to improve stacking stability.
			{
				twistSpeed := DotW8(cm.normal, SubVW8(bB.w, bA.w))
				maxLambda := MulW8(c.friction, totalTwistLimit)
				oldImpulse := cm.twistImpulse
				impulse := NegW8(MulW8(cm.twistMass, twistSpeed))
				impulse = MaxW8(SubW8(NegW8(maxLambda), oldImpulse), MinW8(impulse, SubW8(maxLambda, oldImpulse)))
				cm.twistImpulse = AddW8(oldImpulse, impulse)

				bA.w = MulSubSVW8(bA.w, impulse, MulMVW(c.invIA, cm.normal))
				bB.w = MulAddSVW8(bB.w, impulse, MulMVW(c.invIB, cm.normal))
			}

			// Central friction. Friction goes last to improve stacking stability.
			{
				tangent1 := cm.tangent1
				tangent2 := cm.tangent2

				// Fixed anchor points for applying impulses
				rA := cm.centerA
				rB := cm.centerB

				angularRelativeVelocity := SubVW8(CrossW8(bB.w, rB), CrossW8(bA.w, rA))

				// Relative tangent velocity at contact
				vt := Vec2W8 {
					AddW8(linearTangentVelocity1, DotW8(angularRelativeVelocity, tangent1)),
					AddW8(linearTangentVelocity2, DotW8(angularRelativeVelocity, tangent2)),
				}

				// Incremental tangent impulse
				deltaImpulse := MulMV2W(cm.tangentMass, vt)
				deltaImpulse = Vec2W8{NegW8(deltaImpulse.x), NegW8(deltaImpulse.y)}
				newImpulse := AddV2W(cm.frictionImpulse, deltaImpulse)

				maxImpulse := MulW8(c.friction, totalNormalImpulse)

				// Clamp the accumulated impulse
				lengthSquared := AddW8(MulW8(newImpulse.x, newImpulse.x), MulW8(newImpulse.y, newImpulse.y))

				// Max impulse can be zero
				mask := GreaterThanW8(lengthSquared, MulW8(maxImpulse, maxImpulse))

				// No approximate _mm_rsqrt_ps here to maintain cross-platform determinism. Add epsilon to avoid divide by
				// zero.
				normalize := DivW8(maxImpulse, AddW8(SqrtW8(lengthSquared), epsilonW))
				scale := BlendW8(oneW, normalize, mask)
				newImpulse = Vec2W8{MulW8(scale, newImpulse.x), MulW8(scale, newImpulse.y)}

				deltaImpulse = Vec2W8 {
					SubW8(newImpulse.x, cm.frictionImpulse.x),
					SubW8(newImpulse.y, cm.frictionImpulse.y),
				}

				cm.frictionImpulse = newImpulse

				// Apply delta impulse
				P := AddVW8(MulSVW8(deltaImpulse.x, tangent1), MulSVW8(deltaImpulse.y, tangent2))
				bA.w = MulSubMVW(bA.w, c.invIA, CrossW8(rA, P))
				bB.w = MulAddMVW(bB.w, c.invIB, CrossW8(rB, P))

				P = MulAddSVW8(P, manifoldImpulse, cm.normal)
				bA.v = MulSubSVW8(bA.v, c.invMassA, P)
				bB.v = MulAddSVW8(bB.v, c.invMassB, P)
			}
		}

		ScatterBodies(states, &c.indexA[0], &bA)
		ScatterBodies(states, &c.indexB[0], &bB)

		c = NextConstraintW(c, manifoldCount)
	}
}

@(private = "file", enable_target_feature = "avx2")
ApplyRestitutionW :: #force_inline proc(
	block: SolverBlock,
	context_: ^StepContext,
	base: rawptr,
	manifoldStarts: [^]i32,
	fixedManifoldCount: i32,
) {
	states := context_.states
	inv_h := SplatW8(context_.inv_h)
	negRestitutionThreshold := SplatW8(-context_.world.restitutionThreshold)
	zeroW := ZeroW8()
	propagate := context_.world.enableRestitutionPropagation

	next := GetConstraintW(base, manifoldStarts, block.startIndex, fixedManifoldCount)
	for i: i32 = 0; i < i32(block.count); i += 1 {
		c := next
		manifoldCount := fixedManifoldCount > 0 ? fixedManifoldCount : c.manifoldCount
		next = NextConstraintW(c, manifoldCount)

		if propagate == false && AllZeroW8(c.restitution) {
			continue
		}

		bA := GatherBodies(states, &c.indexA[0])
		bB := GatherBodies(states, &c.indexB[0])

		restitutionMask := GreaterThanW8(c.restitution, zeroW)
		dp := SubVW8(bB.dp, bA.dp)

		manifolds := GetManifoldsW(c)
		for manifoldIndex: i32 = 0; manifoldIndex < manifoldCount; manifoldIndex += 1 {
			cm := &manifolds[manifoldIndex]

			normalSeparation := DotW8(cm.normal, dp)
			normalA := InvRotateVectorW(bA.dq, cm.normal)
			normalB := InvRotateVectorW(bB.dq, cm.normal)

			// Read the point count rather than put on stack to avoid register spills.
			for pointIndex: i32 = 0; pointIndex < cm.pointCount; pointIndex += 1 {
				cp := &cm.points[pointIndex]

				rA := cp.anchorAs
				rB := cp.anchorBs

				s := AddW8(AddW8(normalSeparation, SubW8(DotW8(normalB, rB), DotW8(normalA, rA))), cp.baseSeparations)

				normalMass := propagate ? cp.normalMasses : BlendW8(zeroW, cp.normalMasses, restitutionMask)

				compressionImpulse := SubW8(cp.totalNormalImpulses, cp.restitutionImpulses)
				armed := AndW8(
					AndW8(restitutionMask, LessThanW8(cp.relativeVelocities, negRestitutionThreshold)),
					GreaterThanW8(compressionImpulse, zeroW),
				)

				specBias := MaxW8(zeroW, MulW8(s, inv_h))
				velocityBias := BlendW8(specBias, MulW8(c.restitution, cp.relativeVelocities), armed)

				vrA := AddVW8(bA.v, CrossW8(bA.w, rA))
				vrB := AddVW8(bB.v, CrossW8(bB.w, rB))
				vn := DotW8(SubVW8(vrB, vrA), cm.normal)

				negImpulse := MulW8(normalMass, AddW8(vn, velocityBias))

				newImpulse := MaxW8(SubW8(cp.normalImpulses, negImpulse), zeroW)
				impulse := SubW8(newImpulse, cp.normalImpulses)

				approachImpulse := MinW8(MaxW8(NegW8(MulW8(normalMass, vn)), zeroW), MaxW8(impulse, zeroW))
				allowance := SubW8(
					MulW8(c.restitution, AddW8(compressionImpulse, approachImpulse)),
					cp.restitutionImpulses,
				)
				maxImpulse := AddW8(approachImpulse, MaxW8(allowance, zeroW))
				impulse = BlendW8(impulse, MinW8(impulse, maxImpulse), armed)

				cp.normalImpulses = AddW8(cp.normalImpulses, impulse)
				cp.restitutionImpulses = AddW8(cp.restitutionImpulses, SubW8(impulse, approachImpulse))
				cp.totalNormalImpulses = AddW8(cp.totalNormalImpulses, impulse)

				P := MulSVW8(impulse, cm.normal)
				bA.w = MulSubMVW(bA.w, c.invIA, CrossW8(rA, P))
				bA.v = MulSubSVW8(bA.v, c.invMassA, P)
				bB.w = MulAddMVW(bB.w, c.invIB, CrossW8(rB, P))
				bB.v = MulAddSVW8(bB.v, c.invMassB, P)
			}
		}

		ScatterBodies(states, &c.indexA[0], &bA)
		ScatterBodies(states, &c.indexB[0], &bB)
	}
}

// Store impulses by contact constraint
@(private = "file", enable_target_feature = "avx2")
StoreImpulsesW :: #force_inline proc(
	block: SolverBlock,
	context_: ^StepContext,
	workerIndex: i32,
	base: rawptr,
	manifoldStarts: [^]i32,
	fixedManifoldCount: i32,
) {
	world := context_.world
	taskContext := &world.taskContexts.data[workerIndex]
	hitEventBitSet := &taskContext.hitEventBitSet
	hasHitEvents := taskContext.hasHitEvents
	negHitThreshold := -world.hitEventThreshold

	c := GetConstraintW(base, manifoldStarts, block.startIndex, fixedManifoldCount)
	for i: i32 = 0; i < i32(block.count); i += 1 {
		manifoldCount := fixedManifoldCount > 0 ? fixedManifoldCount : c.manifoldCount
		manifolds := GetManifoldsW(c)

		// Pay the cache misses up front.
		laneManifolds: [SIMD_WIDTH][^]Manifold
		for lane: i32 = 0; lane < SIMD_WIDTH; lane += 1 {
			contact := c.contacts[lane]
			laneManifolds[lane] = contact != nil ? contact.manifolds : nil
		}

		for lane: i32 = 0; lane < SIMD_WIDTH; lane += 1 {
			contact := c.contacts[lane]
			if contact == nil {
				continue
			}

			laneManifoldCount := fixedManifoldCount > 0 ? fixedManifoldCount : contact.manifoldCount
			assert(laneManifoldCount == contact.manifoldCount && laneManifoldCount <= manifoldCount)

			for manifoldIndex: i32 = 0; manifoldIndex < laneManifoldCount; manifoldIndex += 1 {
				cm := &manifolds[manifoldIndex]
				m := &laneManifolds[lane][manifoldIndex]

				frictionImpulse1 := cast([^]f32)&cm.frictionImpulse.x
				frictionImpulse2 := cast([^]f32)&cm.frictionImpulse.y
				tangent1X := cast([^]f32)&cm.tangent1.X
				tangent1Y := cast([^]f32)&cm.tangent1.Y
				tangent1Z := cast([^]f32)&cm.tangent1.Z
				tangent2X := cast([^]f32)&cm.tangent2.X
				tangent2Y := cast([^]f32)&cm.tangent2.Y
				tangent2Z := cast([^]f32)&cm.tangent2.Z
				twistImpulse := cast([^]f32)&cm.twistImpulse
				rollingImpulseX := cast([^]f32)&cm.rollingImpulse.X
				rollingImpulseY := cast([^]f32)&cm.rollingImpulse.Y
				rollingImpulseZ := cast([^]f32)&cm.rollingImpulse.Z

				f1 := frictionImpulse1[lane]
				f2 := frictionImpulse2[lane]
				m.frictionImpulse = Vec3 {
					f1 * tangent1X[lane] + f2 * tangent2X[lane],
					f1 * tangent1Y[lane] + f2 * tangent2Y[lane],
					f1 * tangent1Z[lane] + f2 * tangent2Z[lane],
				}
				m.twistImpulse = twistImpulse[lane]
				m.rollingImpulse = Vec3{rollingImpulseX[lane], rollingImpulseY[lane], rollingImpulseZ[lane]}

				pointCount := m.pointCount
				assert(pointCount <= cm.pointCount)
				for pointIndex: i32 = 0; pointIndex < pointCount; pointIndex += 1 {
					cp := &cm.points[pointIndex]
					normalImpulse := cast([^]f32)&cp.normalImpulses
					totalNormalImpulse := cast([^]f32)&cp.totalNormalImpulses

					mp := &m.points[pointIndex]
					mp.normalImpulse = normalImpulse[lane]
					mp.totalNormalImpulse = totalNormalImpulse[lane]
				}
			}

			if (contact.flags & simEnableHitEvent) != 0 {
				flagged := false
				for manifoldIndex: i32 = 0; manifoldIndex < laneManifoldCount && flagged == false; manifoldIndex += 1 {
					m := &contact.manifolds[manifoldIndex]
					for pointIndex: i32 = 0; pointIndex < m.pointCount; pointIndex += 1 {
						mp := &m.points[pointIndex]

						// Need to check total impulse because the point may be speculative and not colliding
						if mp.normalVelocity < negHitThreshold && mp.totalNormalImpulse > 0.0 {
							SetBit(hitEventBitSet, u32(contact.contactId))
							hasHitEvents = true
							flagged = true
							break
						}
					}
				}
			}
		}

		c = NextConstraintW(c, manifoldCount)
	}

	taskContext.hasHitEvents = hasHitEvents
}

// These wrappers allow the implementation be shared between convex and mesh contacts.

@(enable_target_feature = "avx2")
WarmStartContacts_ConvexW8 :: proc(block: SolverBlock, context_: ^StepContext) {
	WarmStartContactsW(block, context_, context_.graph.colors[block.colorIndex].wideConstraints, nil, 1)
}

@(enable_target_feature = "avx2")
PushContacts_ConvexW8 :: proc(block: SolverBlock, context_: ^StepContext) {
	PushContactsW(block, context_, context_.graph.colors[block.colorIndex].wideConstraints, nil, 1)
}

@(enable_target_feature = "avx2")
SolveContacts_ConvexW8 :: proc(block: SolverBlock, context_: ^StepContext) {
	SolveContactsW(block, context_, context_.graph.colors[block.colorIndex].wideConstraints, nil, 1)
}

@(enable_target_feature = "avx2")
ApplyRestitution_ConvexW8 :: proc(block: SolverBlock, context_: ^StepContext) {
	ApplyRestitutionW(block, context_, context_.graph.colors[block.colorIndex].wideConstraints, nil, 1)
}

@(enable_target_feature = "avx2")
StoreImpulses_ConvexW8 :: proc(block: SolverBlock, context_: ^StepContext, workerIndex: i32) {
	StoreImpulsesW(block, context_, workerIndex, context_.wideConstraints, nil, 1)
}

@(enable_target_feature = "avx2")
WarmStartContacts_MeshWideW8 :: proc(block: SolverBlock, context_: ^StepContext) {
	color := &context_.graph.colors[block.colorIndex]
	WarmStartContactsW(block, context_, color.wideMeshConstraints, color.wideMeshManifoldStarts, 0)
}

@(enable_target_feature = "avx2")
PushContacts_MeshWideW8 :: proc(block: SolverBlock, context_: ^StepContext) {
	color := &context_.graph.colors[block.colorIndex]
	PushContactsW(block, context_, color.wideMeshConstraints, color.wideMeshManifoldStarts, 0)
}

@(enable_target_feature = "avx2")
SolveContacts_MeshWideW8 :: proc(block: SolverBlock, context_: ^StepContext) {
	color := &context_.graph.colors[block.colorIndex]
	SolveContactsW(block, context_, color.wideMeshConstraints, color.wideMeshManifoldStarts, 0)
}

@(enable_target_feature = "avx2")
ApplyRestitution_MeshWideW8 :: proc(block: SolverBlock, context_: ^StepContext) {
	color := &context_.graph.colors[block.colorIndex]
	ApplyRestitutionW(block, context_, color.wideMeshConstraints, color.wideMeshManifoldStarts, 0)
}

@(enable_target_feature = "avx2")
StoreImpulses_MeshWideW8 :: proc(block: SolverBlock, context_: ^StepContext, workerIndex: i32) {
	StoreImpulsesW(block, context_, workerIndex, context_.wideMeshConstraints, context_.wideMeshManifoldStarts, 0)
}
